  "articles": [
    {
      "sequence_id": 1,
      "text": "ネルソン: じゃあ、子供たちをお願いします。 (Neruson: Jaa, kodomo-tachi o onegai shimasu.)"
    },
    {
      "sequence_id": 2,
      "text": "NELSON: Well, please look after the children while we are out."
    },
    {
      "sequence_id": 3,
      "text": "みちこ: はい。いっていらっしゃい。 (Michiko: Hai. Itte irasshai.)"
    },
    {
      "sequence_id": 4,
      "text": "MICHIKO: Certainly. Bye."
    },
    {
      "sequence_id": 5,
      "text": "ネルソン: いってまいります。 (Neruson: Itte mairimasu.)"
    },
    {
      "sequence_id": 6,
      "text": "NELSON: See you later."
    },
    {
      "sequence_id": 7,
      "text": "ネルソン: ただいま。 (Neruson: Tadaima.)"
    },
    {
      "sequence_id": 8,
      "text": "NELSON: We're home."
    },
    {
      "sequence_id": 9,
      "text": "みちこ: お帰りなさい。 (Michiko: Okaerinasai.)"
    },
    {
      "sequence_id": 10,
      "text": "MICHIKO: Welcome back."
    },
    {
      "sequence_id": 11,
      "text": "ネルソン: 子供たちは? (Neruson: Kodomo-tachi wa?)"
    },
    {
      "sequence_id": 12,
      "text": "NELSON: How are the children?"
    },
    {
      "sequence_id": 13,
      "text": "みちこ: ちょっと前に寝ました。 (Michiko: Chotto mae ni nemashita.)"
    },
    {
      "sequence_id": 14,
      "text": "MICHIKO: They went to sleep a little while ago."
    }
  ],
