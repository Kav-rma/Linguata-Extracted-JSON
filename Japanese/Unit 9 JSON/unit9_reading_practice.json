  "articles": [
    {
      "text": "Reading Practice: Directions to the subway station.",
      "sequence_id": 1
    },
    {
      "text": "Mr. Taylor asks a passer-by, \"Sumimasen. Kono chikaku ni chikatetsu no eki ga arimasu ka?\" (Excuse me. Is there a subway station near here?).",
      "sequence_id": 2
    },
    {
      "text": "The passer-by says, \"Ee\" (Yes), and begins to explain the way.",
      "sequence_id": 3
    },
    {
      "text": "The passer-by says, \"Kono michi o massugu itte\" (Go straight along this road).",
      "sequence_id": 4
    },
    {
      "text": "Then, \"Futatsu-me no kado o migi ni magarimasu\" (Turn right at the second corner).",
      "sequence_id": 5
    },
    {
      "text": "Finally, \"Eki wa hidari ni arimasu yo\" (The station is on the left).",
      "sequence_id": 6
    },
    {
      "text": "Mr. Taylor repeats each step to be sure, then says, \"Doomo arigatoo\" (Thank you very much).",
      "sequence_id": 7
    }
  ],
