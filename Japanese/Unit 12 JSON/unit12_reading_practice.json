  "articles": [
    {
      "text": "Reading Practice: Finding the right platform.",
      "sequence_id": 1
    },
    {
      "text": "Mr. Williams wants to go to Yokohama by train.",
      "sequence_id": 2
    },
    {
      "text": "He asks a passer-by, \"Sumimasen. Yokohama e ikitain desu ga, kono hoomu desu ka?\" (Excuse me. I want to go to Yokohama; is this the platform?).",
      "sequence_id": 3
    },
    {
      "text": "The passer-by says that Yokohama is on the Yokosuka Line and points, \"Mukoo no hoo desu yo\" (It's over that way).",
      "sequence_id": 4
    },
    {
      "text": "Mr. Williams asks, \"Mukoo?\" (Over there?).",
      "sequence_id": 5
    },
    {
      "text": "The passer-by answers, \"Ee, ichi-bansen to ni-bansen desu\" (Yes, tracks number 1 and number 2).",
      "sequence_id": 6
    },
    {
      "text": "Mr. Williams says, \"Soo desu ka. Doomo arigatoo\" (I see. Thank you very much).",
      "sequence_id": 7
    }
