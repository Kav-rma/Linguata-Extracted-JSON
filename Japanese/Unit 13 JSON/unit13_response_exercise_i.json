      "sequence_id": 1,
      "text": "学生: すみません、ここはどこですか。 (Gakusei: Sumimasen, koko wa doko desu ka?)"
    },
    {
      "sequence_id": 2,
      "text": "STUDENT: Excuse me, where is this?"
    },
    {
      "sequence_id": 3,
      "text": "教師: 渋谷です。 (Kyoushi: Shibuya desu.)"
    },
    {
      "sequence_id": 4,
      "text": "INSTRUCTOR: It is Shibuya."
    },
    {
      "sequence_id": 5,
      "text": "学生: 虎ノ門はいくつ目ですか。 (Gakusei: Toranomon wa ikutsu-me desu ka?)"
    },
    {
      "sequence_id": 6,
      "text": "STUDENT: How many stops is Toranomon?"
    },
    {
      "sequence_id": 7,
      "text": "教師: ここから三つ目です。 (Kyoushi: Koko kara mittsu-me desu.)"
    },
    {
      "sequence_id": 8,
      "text": "INSTRUCTOR: It is the third one from here."
    },
    {
      "sequence_id": 9,
      "text": "学生: どうもありがとうございます。 (Gakusei: Doomo arigatoo gozaimasu.)"
    },
    {
      "sequence_id": 10,
      "text": "STUDENT: Thank you very much."
    },
    {
      "sequence_id": 11,
      "text": "教師: いいえ。 (Kyoushi: Iie.)"
    },
    {
      "sequence_id": 12,
      "text": "INSTRUCTOR: You're welcome."
    }
  ],
