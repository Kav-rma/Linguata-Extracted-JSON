  "articles": [
    {
      "text": "Reading Practice: Finding the Kabuki Theater.",
      "sequence_id": 1
    },
    {
      "text": "Mr. Jones is walking in Tokyo and wants to find the Kabukiza (Kabuki Theater).",
      "sequence_id": 2
    },
    {
      "text": "He stops a passer-by and asks, \"Sumimasen. Koko wa Harumi Doori desu ka?\" (Excuse me. Is this Harumi Street?).",
      "sequence_id": 3
    },
    {
      "text": "The passer-by answers, \"Ee, soo desu yo\" (Yes, that's right).",
      "sequence_id": 4
    },
    {
      "text": "Mr. Jones then asks, \"Kabukiza wa doko desu ka?\" (Where is the Kabuki Theater?).",
      "sequence_id": 5
    },
    {
      "text": "The passer-by says, \"Koko kara mittsu-me no hidari no kado desu\" (It is the third corner on the left from here).",
      "sequence_id": 6
    },
    {
      "text": "Mr. Jones repeats, \"Mittsu-me no hidari no kado desu ne?\" (The third corner on the left, right?), and thanks the person.",
      "sequence_id": 7
    }
  ],
