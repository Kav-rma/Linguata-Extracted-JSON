    {
      "sequence_id": 2,
      "text": "BROWN: Excuse me, is this the Ginza?"
    },
    {
      "sequence_id": 3,
      "text": "日本人: いいえ、銀座は向こうです。 (Nihonjin: Iie, Ginza wa mukoo desu.)"
