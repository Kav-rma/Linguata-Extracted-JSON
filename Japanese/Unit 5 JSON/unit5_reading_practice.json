  "articles": [
    {
      "text": "Reading Practice: Meeting someone for the first time.",
      "sequence_id": 1
    },
    {
      "text": "At a party, Mr. Brown wants to meet a man he has not met before.",
      "sequence_id": 2
    },
    {
      "text": "To make sure of the man's name, he says, \"Shitsurei desu ga, Suzuki-san desu ka?\" (Excuse me, are you Mr. Suzuki?).",
      "sequence_id": 3
    },
    {
      "text": "The man answers, \"Hai, soo desu\" (Yes, that's right).",
      "sequence_id": 4
    },
    {
      "text": "Mr. Brown says, \"Hajimemashite. Buraun desu\" (How do you do? I am Brown).",
      "sequence_id": 5
    },
    {
      "text": "Mr. Suzuki replies, \"Hajimemashite. Doozo yoroshiku\" (How do you do? Pleased to meet you).",
      "sequence_id": 6
    },
    {
      "text": "They exchange meeshi (name cards) as is the custom in Japan.",
      "sequence_id": 7
    }
  ],
