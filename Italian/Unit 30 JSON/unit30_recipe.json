  "articles": [
    {
      "sequence_id": 1,
      "text": "Falsomagro"
    },
    {
      "sequence_id": 2,
      "text": "Ingredienti:"
    },
    {
      "sequence_id": 3,
      "text": "1 larga fetta di manzo del peso di 800 gr."
    },
    {
      "sequence_id": 4,
      "text": "2 bicchieri di vino rosso secco e corposo (Corvo)"
    },
    {
      "sequence_id": 5,
      "text": "1 spicchio d'aglio"
    },
    {
      "sequence_id": 6,
      "text": "1 fetta di pancetta"
    },
    {
      "sequence_id": 7,
      "text": "2 uova sode"
    },
    {
      "sequence_id": 8,
      "text": "pecorino fresco a fette"
    },
    {
      "sequence_id": 9,
      "text": "250 gr. di trito di carne e salsiccia"
    },
    {
      "sequence_id": 10,
      "text": "2 cipolle"
    },
    {
      "sequence_id": 11,
      "text": "1 litro di brodo e/o l'equivalente di salsa di pomodoro"
    },
    {
      "sequence_id": 12,
      "text": "preparazione:"
    },
    {
      "sequence_id": 13,
      "text": "Rosolare il trito di carne con la cipolla a fette."
    },
    {
      "sequence_id": 14,
      "text": "Nel frattempo aprire la fetta di carne, metterci la fetta di pancetta, le uova sode affettate, le fette di pecorino, l'aglio tritato finemente e il trito di carne e un pizzico di sale e pepe."
    },
    {
      "sequence_id": 15,
      "text": "Arrotolare la fetta di carne, e legarla con filo resistente."
    },
    {
      "sequence_id": 16,
      "text": "In un tegame far soffriggere l'altra cipolla, far rosolare l'involtino di carne, versarvi quindi il vino, e lasciarlo evaporare."
    },
    {
      "sequence_id": 17,
      "text": "Completare la cottura o aggiungendo 1 litro di brodo o della salsa di pomodoro."
    },
    {
      "sequence_id": 18,
      "text": "Alcuni vini siciliani"
    },
    {
      "sequence_id": 19,
