  "articles": [
    { "sequence_id": 1, "text": "Pasta a «picchi pacchiu»" },
    { "sequence_id": 2, "text": "Ingredienti:" },
    { "sequence_id": 3, "text": "1 chilo di pomodori maturi" },
    { "sequence_id": 4, "text": "4 spicchi d'aglio" },
    { "sequence_id": 5, "text": "peperoncino rosso" },
    { "sequence_id": 6, "text": "basilico" },
    { "sequence_id": 7, "text": "1 bicchiere e mezzo d'olio di oliva" },
    { "sequence_id": 8, "text": "700 gr. di spaghetti" },
    { "sequence_id": 9, "text": "preparazione:" },
    { "sequence_id": 10, "text": "Pelare i pomodori, togliere i semi e tagliarli a tocchi, metterli quindi in un largo piatto di ceramica, aggiungere l'aglio affettato finemente, sale, il peperoncino, le foglie di basilico e l'olio." },
    { "sequence_id": 11, "text": "Mescolare bene e coprire il piatto." },
    { "sequence_id": 12, "text": "Lasciare riposare per almeno tre ore." },
    { "sequence_id": 13, "text": "Cuocere gli spaghetti e versarli nel piatto dove c'è la salsa." },
    { "sequence_id": 14, "text": "Prima di servire grattugiare sugli spaghetti del caciocavallo." },
    { "sequence_id": 15, "text": "Pasta alla Norma" },
    { "sequence_id": 16, "text": "Ingredienti:" },
    { "sequence_id": 17, "text": "salsa di pomodoro" },
    { "sequence_id": 18, "text": "3 melanzane" },
    { "sequence_id": 19, "text": "basilico" },
    { "sequence_id": 20, "text": "ricotta salata grattugiata" },
    { "sequence_id": 21, "text": "spaghetti" },
    { "sequence_id": 22, "text": "preparazione:" },
    { "sequence_id": 23, "text": "Preparare la salsa con il pomodoro fresco e aromatizzarla con il basilico." },
    { "sequence_id": 24, "text": "Tagliare a tocchetti le melanzane (o a strisce se preferite) e tenerle sotto sale per un'ora circa." },
    { "sequence_id": 25, "text": "Friggerle quindi in abbondante olio." },
    { "sequence_id": 26, "text": "Cuocere gli spaghetti al dente e condirli con la salsa, aggiungere le melanzane e una buona manciata di ricotta salata grattugiata." }
  ],
