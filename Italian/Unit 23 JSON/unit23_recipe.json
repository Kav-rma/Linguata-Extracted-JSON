    "articles": [
      {
        "sequence_id": 1,
        "text": "Polenta e spiedini di vitello"
      },
      {
        "sequence_id": 2,
        "text": "Ingredienti per la polenta:"
      },
      {
        "sequence_id": 3,
        "text": "2 litri d'acqua"
      },
      {
        "sequence_id": 4,
        "text": "500 grammi di farina di granoturco"
      },
      {
        "sequence_id": 5,
        "text": "un cucchiaio di sale"
      },
      {
        "sequence_id": 6,
        "text": "preparazione:"
      },
      {
        "sequence_id": 7,
        "text": "Salare l'acqua e portarla all'ebollizione."
      },
      {
        "sequence_id": 8,
        "text": "Versare lentamente la farina nell'acqua mescolando e facendo attenzione a non formare grumi."
      },
      {
        "sequence_id": 9,
        "text": "Mescolare continuamente rivoltando l'intero impasto spesso."
      },
      {
        "sequence_id": 10,
        "text": "Cuocere per 45 o 50 minuti fino a cottura completa."
      },
      {
        "sequence_id": 11,
        "text": "Ingredienti per gli spiedini di vitello (per 4 persone):"
      },
      {
        "sequence_id": 12,
        "text": "800 gr. di vitello tagliato a cubetti piuttosto grossi"
      },
      {
        "sequence_id": 13,
        "text": "6 fettine di pancetta affettata grossa"
      },
      {
        "sequence_id": 14,
        "text": "alcune foglie di salvia"
      },
      {
        "sequence_id": 15,
        "text": "sale, pepe"
      },
      {
        "sequence_id": 16,
        "text": "un bicchiere di vino bianco"
      },
      {
        "sequence_id": 17,
        "text": "preparazione:"
      },
      {
        "sequence_id": 18,
        "text": "Tagliare le fettine di pancetta a strisce della lunghezza di 2 cm. circa."
      },
      {
        "sequence_id": 19,
        "text": "Infilare negli spiedini i cubetti di carne alternandoli con le fettine di pancetta e una foglia di salvia e salare."
      },
      {
        "sequence_id": 20,
        "text": "Rosolare gli spiedini, ottenuti, in abbondante olio e burro."
      },
      {
        "sequence_id": 21,
        "text": "Dopo averli rosolati bagnarli un po' alla volta con il vino bianco tenendo la pentola aperta."
      },
      {
        "sequence_id": 22,
        "text": "Se necessario aggiungere un po' d'acqua fino a completa cottura della carne."
      },
      {
        "sequence_id": 23,
        "text": "Se si vuole ottenere un intingolo più ricco da accompagnare alla polenta si può, verso l'ultimo aggiungere un po' di panna da tavola."
      },
      {
        "sequence_id": 24,
        "text": "Alcuni vini veneti"
      },
      {
        "sequence_id": 25,
        "text": "Soave e Recioto di Soave"
      },
      {
        "sequence_id": 26,
        "text": "Bardolino"
      },
      {
        "sequence_id": 27,
        "text": "Tocai di San Martino della Battaglia"
      },
      {
        "sequence_id": 28,
        "text": "Valpolicella"
      },
      {
        "sequence_id": 29,
        "text": "Breganze Merlot e Cabernet di Pramaggiore"
      }
    ],
