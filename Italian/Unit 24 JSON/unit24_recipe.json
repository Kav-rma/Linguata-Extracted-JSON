    "articles": [
      {
        "sequence_id": 1,
        "text": "Fegato alla veneziana"
      },
      {
        "sequence_id": 2,
        "text": "Ingredienti (per 4 persone):"
      },
      {
        "sequence_id": 3,
        "text": "4 fette sottili di fegato di vitello (400 gr.)"
      },
      {
        "sequence_id": 4,
        "text": "cipolle (200 gr.)"
      },
      {
        "sequence_id": 5,
        "text": "sale e pepe q. b."
      },
      {
        "sequence_id": 6,
        "text": "una manciata di prezzemolo"
      },
      {
        "sequence_id": 7,
        "text": "preparazione:"
      },
      {
        "sequence_id": 8,
        "text": "Mettere il fegato in una padella (preferibilmente con il manico lungo) con una cucchiaiata di olio d'oliva e la cipolla affettata sottilissima, salare e pepare."
      },
      {
        "sequence_id": 9,
        "text": "Cuocere a fuoco ardente ed evitare una cottura prolungata che indurirebbe il fegato."
      },
      {
        "sequence_id": 10,
        "text": "Prima di spegnere il fornello aggiungere il prezzemolo."
      },
      {
        "sequence_id": 11,
        "text": "Ricordatevi di agitare il fegato durante la cottura."
      },
      {
        "sequence_id": 12,
        "text": "Alcuni vini sardi"
      },
      {
        "sequence_id": 13,
        "text": "Girò di Cagliari"
      },
      {
        "sequence_id": 14,
        "text": "Vernaccia di Oristano"
      },
      {
        "sequence_id": 15,
        "text": "Monica di Sardegna"
      },
      {
        "sequence_id": 16,
        "text": "Vermentino di Gallura"
      },
      {
        "sequence_id": 17,
        "text": "Malvasia di Bosa"
      },
      {
        "sequence_id": 18,
        "text": "Alcuni vini calabresi"
      },
      {
        "sequence_id": 19,
