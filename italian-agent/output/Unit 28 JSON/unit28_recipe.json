  "articles": [
    {
      "sequence_id": 1,
      "text": "Gattò di riso"
    },
    {
      "sequence_id": 2,
      "text": "Ingredienti:"
    },
    {
      "sequence_id": 3,
      "text": "per il riso:"
    },
    {
      "sequence_id": 4,
      "text": "½ kg. di riso"
    },
    {
      "sequence_id": 5,
      "text": "2 uova"
    },
    {
      "sequence_id": 6,
      "text": "½ etto di burro"
    },
    {
      "sequence_id": 7,
      "text": "½ etto di parmigiano"
    },
    {
      "sequence_id": 8,
      "text": "sale q.b."
    },
    {
      "sequence_id": 9,
      "text": "per il ripieno:"
    },
    {
      "sequence_id": 10,
      "text": "carne di vitello per spezzatino 400 gr."
    },
    {
      "sequence_id": 11,
      "text": "besciamella"
    },
    {
      "sequence_id": 12,
      "text": "una cipollina"
    },
    {
      "sequence_id": 13,
      "text": "3 uova sode"
    },
    {
      "sequence_id": 14,
      "text": "200 gr. di pisellini"
    },
    {
      "sequence_id": 15,
      "text": "150 gr. di formaggio fresco"
    },
    {
      "sequence_id": 16,
      "text": "un bicchiere di vino bianco"
    },
    {
      "sequence_id": 17,
      "text": "per la besciamella:"
    },
    {
      "sequence_id": 18,
      "text": "½ l di latte"
    },
    {
      "sequence_id": 19,
      "text": "50 gr. di burro"
    },
    {
      "sequence_id": 20,
      "text": "2 cucchiai di farina"
    },
    {
      "sequence_id": 21,
      "text": "un pizzico di noce moscata"
    },
    {
      "sequence_id": 22,
      "text": "sale e pepe q.b."
    },
    {
      "sequence_id": 23,
      "text": "preparazione:"
    },
    {
      "sequence_id": 24,
      "text": "Cuocere il riso in acqua salata lasciandolo piuttosto al dente, scolarlo e unirvi tutti gli ingredienti."
    },
    {
      "sequence_id": 25,
      "text": "Con il riso così condito, foderare una teglia (già imburrata e spolverizzata con della mollica)."
    },
    {
      "sequence_id": 26,
      "text": "A parte fare imbiondire la cipollina, rosolare la carne tagliata a dadini e fare cuocere il tutto per qualche minuto a fuoco forte, versare quindi il bicchiere di vino, salare e pepare, aggiungervi i piselli, (cotti a parte) pochi minuti prima di spegnere il fuoco."
    },
    {
      "sequence_id": 27,
      "text": "Preparare la besciamella* (vedi sotto)."
    },
    {
      "sequence_id": 28,
      "text": "Adesso mettere nella teglia uno strato di riso, uno di carne con i piselli, uno di besciamella, le uova sode tagliate a fette, e il formaggio fresco; poi ancora uno di riso, uno di carne e così via fino ad esaurire tutti gli ingredienti."
    },
    {
      "sequence_id": 29,
      "text": "Mettere dei fiocchetti di burro e spolverizzare con dell'altra mollica."
    },
    {
      "sequence_id": 30,
      "text": "Infornare per un'ora circa alla temperatura di 250 gradi."
    },
    {
      "sequence_id": 31,
      "text": "*besciamella"
    },
    {
      "sequence_id": 32,
      "text": "preparazione:"
    },
    {
      "sequence_id": 33,
      "text": "In un pentolino fondere il burro, aggiungere la farina, mescolando sempre per evitare la formazione di grumi."
    },
    {
      "sequence_id": 34,
      "text": "In un altro pentolino, fare scaldare il latte, quando è caldo aggiungerlo un po' per volta all'impasto di burro e farina."
    },
    {
      "sequence_id": 35,
      "text": "Sempre mescolando, portare all'ebollizione."
    },
    {
      "sequence_id": 36,
      "text": "Aggiungere la noce moscata, e sale e pepe a piacere."
    },
    {
      "sequence_id": 37,
      "text": "Riso e piselli / Risi e bisi"
    },
    {
      "sequence_id": 38,
      "text": "Ingredienti (per 4 persone):"
    },
    {
      "sequence_id": 39,
      "text": "1 kg e ½ di piselli novelli"
    },
    {
      "sequence_id": 40,
      "text": "4 pugni di riso"
    },
    {
      "sequence_id": 41,
      "text": "1 cipolla"
    },
    {
      "sequence_id": 42,
      "text": "un po' di pancetta/ o prosciutto crudo"
    },
    {
      "sequence_id": 43,
      "text": "prezzemolo"
    },
    {
      "sequence_id": 44,
      "text": "preparazione:"
    },
    {
      "sequence_id": 45,
      "text": "Rosolare la cipolla in burro e olio con la pancetta a pezzetti o il prosciutto."
    },
    {
      "sequence_id": 46,
      "text": "Appena la cipolla diventa dorata aggiungere il riso e lasciare insaporire."
    },
    {
      "sequence_id": 47,
      "text": "Cuocere in acqua salata i piselli, scolarli."
    },
    {
      "sequence_id": 48,
      "text": "Usare l'acqua dei piselli per far cuocere il riso."
    },
    {
      "sequence_id": 49,
      "text": "A metà cottura del riso aggiungere i pisellini insieme a una manciata di prezzemolo tritato."
    },
    {
      "sequence_id": 50,
      "text": "Quando il riso è cotto, insaporire con un po' di burro e parmigiano grattugiato."
    },
    {
