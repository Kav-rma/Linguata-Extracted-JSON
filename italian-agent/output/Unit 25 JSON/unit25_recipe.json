    "articles": [
      {
        "sequence_id": 1,
        "text": "Pollo in fricò"
      },
      {
        "sequence_id": 2,
        "text": "Ingredienti:"
      },
      {
        "sequence_id": 3,
        "text": "1 pollo di media grandezza"
      },
      {
        "sequence_id": 4,
        "text": "olio, sale e pepe q.b."
      },
      {
        "sequence_id": 5,
        "text": "4 spicchi d'aglio"
      },
      {
        "sequence_id": 6,
        "text": "rosmarino"
      },
      {
        "sequence_id": 7,
        "text": "2 limoni"
      },
      {
        "sequence_id": 8,
        "text": "preparazione:"
      },
      {
        "sequence_id": 9,
        "text": "Mettere in una padella l'olio, il pollo tagliato a pezzi, aggiungere gli spicchi d'aglio tagliati a pezzi piuttosto grandi, quindi cospargere di rosmarino."
      },
      {
        "sequence_id": 10,
        "text": "Cuocere a fuoco molto forte (dovrà fare una crosta molto spessa), poi girare i pezzi di pollo e diminuire un po' il fuoco."
      },
      {
        "sequence_id": 11,
        "text": "Se necessario scolare l'eccesso di olio."
      },
      {
        "sequence_id": 12,
        "text": "A cottura ultimata circa 35-40 minuti aggiungere il succo di limone e servirlo."
      },
      {
        "sequence_id": 13,
        "text": "Torta di riso"
      },
      {
        "sequence_id": 14,
        "text": "Ingredienti:"
      },
      {
        "sequence_id": 15,
        "text": "1 litro di latte"
      },
      {
        "sequence_id": 16,
        "text": "250 gr. di riso"
      },
      {
        "sequence_id": 17,
        "text": "250 gr. di zucchero"
      },
      {
        "sequence_id": 18,
        "text": "100 gr. di farina"
      },
      {
        "sequence_id": 19,
        "text": "4 uova"
      },
      {
        "sequence_id": 20,
        "text": "1 scorza di limone grattugiata"
      },
      {
        "sequence_id": 21,
        "text": "preparazione:"
      },
      {
        "sequence_id": 22,
        "text": "Cuocere il riso nel latte con sale, e lasciarlo raffreddare in una terrina."
      },
      {
        "sequence_id": 23,
        "text": "Quando il riso è freddo aggiungere il tuorlo delle uova e lo zucchero."
      },
      {
        "sequence_id": 24,
        "text": "Mescolare bene."
      },
      {
        "sequence_id": 25,
        "text": "Aggiungere, ora la scorza di limone grattugiata e la farina, mescolare bene, poi aggiungere gli albumi montati e versare il tutto in una tortiera imburrata."
      },
      {
        "sequence_id": 26,
        "text": "Infornare a 180° C."
      }
    ],
