  "articles": [
    {
      "sequence_id": 1,
      "text": "Melanzane al forno"
    },
    {
      "sequence_id": 2,
      "text": "Ingredienti:"
    },
    {
      "sequence_id": 3,
      "text": "3 melanzane tagliate a metà"
    },
    {
      "sequence_id": 4,
      "text": "50 gr. di pancetta"
    },
    {
      "sequence_id": 5,
      "text": "qualche spicchio d'aglio tritato"
    },
    {
      "sequence_id": 6,
      "text": "3 filetti di acciughe"
    },
    {
      "sequence_id": 7,
      "text": "pezzettini di formaggio pecorino"
    },
    {
      "sequence_id": 8,
      "text": "2 pomodori pelati"
    },
    {
      "sequence_id": 9,
      "text": "sale e pepe q.b."
    },
    {
      "sequence_id": 10,
      "text": "una pastella composta di: mollica, parmigiano grattugiato, prezzemolo tritato finemente e olio"
    },
    {
      "sequence_id": 11,
      "text": "preparazione:"
    },
    {
      "sequence_id": 12,
      "text": "Incidere le melanzane e farcirle con gli ingredienti (pancetta, aglio, acciughe, pomodoro, pezzettini di formaggio, sale e pepe)."
    },
    {
      "sequence_id": 13,
      "text": "Metterle in una teglia ben oleata, coprirle con la pastella e infornarle nel forno caldo, fino a completa cottura."
    },
    {
      "sequence_id": 14,
      "text": "Bagnetto piemontese"
    },
    {
      "sequence_id": 15,
      "text": "Ingredienti:"
    },
    {
      "sequence_id": 16,
      "text": "2 o 3 mazzetti di prezzemolo"
    },
    {
      "sequence_id": 17,
      "text": "qualche cappero"
    },
    {
      "sequence_id": 18,
      "text": "qualche pezzetto di peperone"
    },
    {
      "sequence_id": 19,
      "text": "1 uovo sodo schiacciato con la forchetta"
    },
    {
      "sequence_id": 20,
      "text": "un po' di conserva e un po' di pasta di acciughe"
    },
    {
      "sequence_id": 21,
      "text": "preparazione:"
    },
    {
      "sequence_id": 22,
      "text": "Tritare finemente il prezzemolo, i capperi e il peperone."
    },
    {
      "sequence_id": 23,
      "text": "Mettere il tutto nella saliera ed aggiungere l'uovo e la pasta di acciughe e un po' di conserva per dare un po' di colore."
    },
    {
      "sequence_id": 24,
      "text": "Condire con sale, olio e aceto."
    },
    {
      "sequence_id": 25,
      "text": "È un buon contorno per il lesso."
    }
  ],
