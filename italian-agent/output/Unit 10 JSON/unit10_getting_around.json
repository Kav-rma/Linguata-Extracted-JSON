    {
      "sequence_id": 1,
      "text": "You are supposed to meet a friend in town, and since it would be too far to walk, you decide to take a bus. You stop a passerby ..."
    },
    {
      "sequence_id": 2,
      "text": "Lei: 1. Scusi, che autobus posso prendere per andare in Via Giovanni Pascoli?"
    },
    {
      "sequence_id": 3,
      "text": "Passante: 2. Deve prendere il 58. La fermata dell'autobus è qui nella piazza. Il biglietto lo prende dal tabaccaio."
    },
    {
      "sequence_id": 4,
      "text": "Lei: 3. Scusi, non capisco. Può parlare più adagio, per favore?"
    },
    {
      "sequence_id": 5,
      "text": "Passante: 4. Certamente. Prenda il 58. La fermata dell'autobus è proprio qui di fronte, nella piazza."
    },
    {
      "sequence_id": 6,
      "text": "Lei: 5. Ah! Grazie mille."
    },
    {
      "sequence_id": 7,
      "text": "Lei: 6. Un biglietto per l'autobus, per favore."
    },
    {
      "sequence_id": 8,
      "text": "Tabac: 7. Sono settecento (lire). Grazie."
    },
    {
      "sequence_id": 9,
      "text": "Lei: 8. Scusi, per andare in Via Giovanni Pascoli, dove devo scendere?"
    },
    {
      "sequence_id": 10,
      "text": "Signora/e: 9. Deve scendere all'angolo di Via Messina. È la prossima fermata. Suoni il campanello perché è una fermata a richiesta."
    },
    {
      "sequence_id": 11,
      "text": "Lei: 10. Quale campanello? Dov'è?"
    },
    {
      "sequence_id": 12,
      "text": "Signora/e: 11. È accanto alla porta, a destra."
    },
    {
      "sequence_id": 13,
      "text": "Lei: 12. Grazie. Permesso ... permesso ... scendo alla prossima."
    },
    {
      "sequence_id": 14,
      "text": "Tabac: Tabaccaio/a"
    }
