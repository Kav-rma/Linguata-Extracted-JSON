  "articles": [
    {
      "sequence_id": 1,
      "text": "Mi dispiace, quello d'angolo è riservato."
    },
    {
      "sequence_id": 2,
      "text": "Posso darvi quello vicino alla finestra."
    },
    {
      "sequence_id": 3,
      "text": "Eccovi anche il menù e la lista dei vini."
    },
    {
      "sequence_id": 4,
      "text": "Volete ordinare subito?"
    },
    {
      "sequence_id": 5,
      "text": "È uno dei piatti tipici di Roma."
    },
    {
      "sequence_id": 6,
      "text": "Sono fatti con salsa di pomodoro e pancetta."
    },
    {
      "sequence_id": 7,
      "text": "Li volete assaggiare?"
    },
    {
      "sequence_id": 8,
      "text": "Volete un aperitivo o preferite ordinare il vino?"
    },
    {
      "sequence_id": 9,
      "text": "Buongiorno signori."
    },
    {
      "sequence_id": 10,
      "text": "Prego, va bene questo tavolo?"
    },
    {
      "sequence_id": 11,
      "text": "Sì, va bene."
    },
    {
      "sequence_id": 12,
      "text": "Grazie."
    },
    {
      "sequence_id": 13,
      "text": "Quello vicino alla finestra è riservato?"
    },
    {
      "sequence_id": 14,
      "text": "No, prego, si accomodino."
    },
    {
      "sequence_id": 15,
      "text": "Vogliono il menù?"
    },
    {
      "sequence_id": 16,
      "text": "Sì, grazie."
    },
    {
      "sequence_id": 17,
      "text": "Sì, grazie, e ci porti un aperitivo intanto che scegliamo."
    },
    {
      "sequence_id": 18,
      "text": "Cosa vogliono ordinare per cominciare?"
    },
    {
      "sequence_id": 19,
      "text": "Ecco gli aperitivi, signori."
    },
    {
      "sequence_id": 20,
      "text": "Vogliono ordinare?"
    },
    {
      "sequence_id": 21,
      "text": "Sì."
    },
    {
      "sequence_id": 22,
      "text": "Come sono fatti gli spaghetti alla carbonara?"
    },
    {
      "sequence_id": 23,
      "text": "Io prendo l'antipasto: prosciutto e melone."
    },
    {
      "sequence_id": 24,
      "text": "Per secondo ... uhm ... sono stufo/a della carne: la mangio ogni giorno."
    },
    {
      "sequence_id": 25,
      "text": "Mi porti la trota con contorno di patate fritte."
    },
    {
      "sequence_id": 26,
      "text": "Per noi, niente primo."
    },
    {
      "sequence_id": 27,
      "text": "Prendiamo il secondo."
    },
    {
      "sequence_id": 28,
      "text": "Vediamo ... ci porti due bistecche ai ferri."
    },
    {
      "sequence_id": 29,
      "text": "Al sangue, per cortesia."
    },
    {
      "sequence_id": 30,
      "text": "Una mezza di lasagne, e per secondo piatto il filetto di bue, come contorno prendo le patate fritte."
    },
    {
      "sequence_id": 31,
      "text": "Il filetto ben cotto, per favore."
    },
    {
      "sequence_id": 32,
      "text": "Io salto l'antipasto, prendo i tortellini in brodo."
    },
    {
      "sequence_id": 33,
      "text": "Posso ordinare il secondo piatto più tardi?"
    },
    {
      "sequence_id": 34,
      "text": "Sono ancora indeciso/a."
    },
    {
      "sequence_id": 35,
      "text": "Io prendo gli spaghetti al ragù."
    },
    {
      "sequence_id": 36,
      "text": "Al dente, mi raccomando!"
    },
    {
      "sequence_id": 37,
      "text": "Gli spaghetti alla carbonara sono conditi con una salsa d'uovo e pancetta."
    },
    {
      "sequence_id": 38,
      "text": "Può ordinare più tardi se è ancora indeciso/a."
    },
    {
      "sequence_id": 39,
      "text": "Da bere porto del vino?"
    },
    {
      "sequence_id": 40,
      "text": "Sì, due bottiglie di Pinot grigio, e una di acqua minerale gassata."
    },
    {
      "sequence_id": 41,
      "text": "Va bene, signori."
    }
  ],
