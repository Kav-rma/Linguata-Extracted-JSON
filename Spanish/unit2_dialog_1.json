  "articles": [
    {
      "sequence_id": 1,
      "text": "JUAN: Por favor, ¿dónde está el hotel?"
    },
    {
      "sequence_id": 2,
      "text": "JUAN: Please, where is the hotel?"
    },
    {
      "sequence_id": 3,
      "text": "SEÑOR: Está aquí cerca, a la derecha."
    },
    {
      "sequence_id": 4,
      "text": "SEÑOR: It's near here, to the right."
    },
    {
      "sequence_id": 5,
      "text": "JUAN: ¿Y hay un restaurante por aquí?"
    },
    {
      "sequence_id": 6,
      "text": "JUAN: And is there a restaurant around here?"
    },
    {
      "sequence_id": 7,
      "text": "SEÑOR: Sí, hay uno a la izquierda."
    },
    {
      "sequence_id": 8,
      "text": "SEÑOR: Yes, there's one to the left."
    },
    {
      "sequence_id": 9,
      "text": "JUAN: ¿Está lejos?"
    },
    {
      "sequence_id": 10,
      "text": "JUAN: Is it far?"
    },
    {
      "sequence_id": 11,
      "text": "SEÑOR: No, está muy cerca."
    },
    {
      "sequence_id": 12,
      "text": "SEÑOR: No, it's very near."
    },
    {
      "sequence_id": 13,
      "text": "JUAN: Muchas gracias, señor."
    },
    {
      "sequence_id": 14,
      "text": "JUAN: Thank you very much, sir."
    },
    {
      "sequence_id": 15,
      "text": "SEÑOR: De nada."
    },
    {
      "sequence_id": 16,
      "text": "SEÑOR: You're welcome."
    }
  ],
