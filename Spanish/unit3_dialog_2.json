  "articles": [
    {
      "sequence_id": 1,
      "text": "JUAN: Dispense, ¿a cómo está el cambio?"
    },
    {
      "sequence_id": 2,
      "text": "JUAN: Excuse me, what's the rate of exchange?"
    },
    {
      "sequence_id": 3,
      "text": "CAJ: Está a tres por uno."
    },
    {
      "sequence_id": 4,
      "text": "CAJ: It's three to one."
    },
    {
      "sequence_id": 5,
      "text": "JUAN: ¿Puede cambiarme este billete?"
    },
    {
      "sequence_id": 6,
      "text": "JUAN: Can you change this bill for me?"
    },
    {
      "sequence_id": 7,
      "text": "CAJ: ¿De cuánto es?"
    },
    {
      "sequence_id": 8,
      "text": "CAJ: How much is it for?"
    },
    {
      "sequence_id": 9,
      "text": "JUAN: Es de veinte dólares."
    },
    {
      "sequence_id": 10,
      "text": "JUAN: It's for twenty dollars."
    },
    {
      "sequence_id": 11,
      "text": "CAJ: Con mucho gusto. ¿Cómo lo quiere?"
    },
    {
      "sequence_id": 12,
      "text": "CAJ: Gladly. How do you want it?"
    },
    {
      "sequence_id": 13,
      "text": "JUAN: Dos de veinte y dos de diez, por favor."
    },
    {
      "sequence_id": 14,
      "text": "JUAN: Two twenties and two tens, please."
    },
    {
      "sequence_id": 15,
      "text": "CAJ: Cómo no, aquí tiene."
    },
    {
      "sequence_id": 16,
      "text": "CAJ: Of course, here you are."
    }
  ],
