  "articles": [
    {
      "sequence_id": 1,
      "text": "JOSÉ: ¿No va a almorzar, Juan?"
    },
    {
      "sequence_id": 2,
      "text": "JOSÉ: Aren't you going to have lunch, Juan?"
    },
    {
      "sequence_id": 3,
      "text": "JUAN: No tengo mucha hambre. ¿Qué hora es?"
    },
    {
      "sequence_id": 4,
      "text": "JUAN: I'm not very hungry. What time is it?"
    },
    {
      "sequence_id": 5,
      "text": "JOSÉ: Son casi las doce. ¿Podemos almorzar juntos?"
    },
    {
      "sequence_id": 6,
      "text": "JOSÉ: It's almost twelve. Can we have lunch together?"
    },
    {
      "sequence_id": 7,
      "text": "JUAN: Muy bien, vamos. ¿A dónde podemos ir?"
    },
    {
      "sequence_id": 8,
      "text": "JUAN: Fine, let's go. Where can we go?"
    },
    {
      "sequence_id": 9,
      "text": "JOSÉ: A la vuelta. Hay un buen restorán ahí."
    },
    {
      "sequence_id": 10,
      "text": "JOSÉ: Around the corner. There's a good restaurant there."
    },
    {
      "sequence_id": 11,
      "text": "JUAN: ¿Es barato?"
    },
    {
      "sequence_id": 12,
      "text": "JUAN: Is it inexpensive?"
    },
    {
      "sequence_id": 13,
      "text": "JOSÉ: Sí, es bastante barato."
    },
    {
      "sequence_id": 14,
      "text": "JOSÉ: Yes, it's quite inexpensive."
    }
  ],
