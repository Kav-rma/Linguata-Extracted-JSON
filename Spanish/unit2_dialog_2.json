  "articles": [
    {
      "sequence_id": 1,
      "text": "JUAN: Perdón, ¿dónde está la embajada americana?"
    },
    {
      "sequence_id": 2,
      "text": "JUAN: Excuse me, where is the American embassy?"
    },
    {
      "sequence_id": 3,
      "text": "SEÑORA: Está en la otra calle, a la izquierda."
    },
    {
      "sequence_id": 4,
      "text": "SEÑORA: It's on the other street, to the left."
    },
    {
      "sequence_id": 5,
      "text": "JUAN: ¿Puedo ir a pie?"
    },
    {
      "sequence_id": 6,
      "text": "JUAN: Can I go on foot?"
    },
    {
      "sequence_id": 7,
      "text": "SEÑORA: Sí, está muy cerca de aquí."
    },
    {
      "sequence_id": 8,
      "text": "SEÑORA: Yes, it's very near here."
    },
    {
      "sequence_id": 9,
      "text": "JUAN: ¿Y dónde está el banco?"
    },
    {
      "sequence_id": 10,
      "text": "JUAN: And where is the bank?"
    },
    {
      "sequence_id": 11,
      "text": "SEÑORA: El banco está a la derecha, cerca del hotel."
    },
    {
      "sequence_id": 12,
      "text": "SEÑORA: The bank is to the right, near the hotel."
    },
    {
      "sequence_id": 13,
      "text": "JUAN: Muchas gracias, señora."
    },
    {
      "sequence_id": 14,
      "text": "JUAN: Thank you very much, ma'am."
    },
    {
      "sequence_id": 15,
      "text": "SEÑORA: Con mucho gusto."
    },
    {
      "sequence_id": 16,
      "text": "SEÑORA: You're welcome."
    }
  ],
