    {
      "sequence_id": 1,
      "text": "José: ¿Es ésta tu copa o la mía?"
    },
    {
      "sequence_id": 2,
      "text": "José: Is this your glass or mine?"
    },
    {
      "sequence_id": 3,
      "text": "Juan: Debe ser la tuya. Yo estoy bebiendo cuba libre."
    },
    {
      "sequence_id": 4,
      "text": "Juan: It must be yours. I'm drinking a cuba libre."
    },
    {
      "sequence_id": 5,
      "text": "José: ¿Por qué no estás bailando?"
    },
    {
      "sequence_id": 6,
      "text": "José: Why aren't you dancing?"
    },
    {
      "sequence_id": 7,
      "text": "Juan: Estoy esperando a mi gordita."
    },
    {
      "sequence_id": 8,
      "text": "Juan: I'm waiting for my chubby girl."
    },
    {
      "sequence_id": 9,
      "text": "José: ¿Dónde está ella?"
    },
    {
      "sequence_id": 10,
      "text": "José: Where is she?"
    },
    {
      "sequence_id": 11,
      "text": "Juan: Está en la cocina ayudando a la señora de la casa a hacer unos tragos."
    },
    {
      "sequence_id": 12,
      "text": "Juan: She's in the kitchen helping the lady of the house make some drinks."
