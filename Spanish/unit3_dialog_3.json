      "sequence_id": 1,
      "text": "JUAN: Lléveme a la Embajada Americana."
    },
    {
      "sequence_id": 2,
      "text": "JUAN: Take me to the American Embassy."
    },
    {
      "sequence_id": 3,
      "text": "CHOF: Perdón, ¿cómo dice?"
    },
    {
      "sequence_id": 4,
      "text": "CHOF: Pardon, what did you say?"
    },
    {
      "sequence_id": 5,
      "text": "JUAN: A la Embajada Americana. ¿Está muy lejos de aquí?"
    },
    {
      "sequence_id": 6,
      "text": "JUAN: To the American Embassy. Is it very far from here?"
    },
    {
      "sequence_id": 7,
      "text": "CHOF: No mucho, está en la Avenida Colón."
    },
    {
      "sequence_id": 8,
      "text": "CHOF: Not much, it's on Columbus Avenue."
    },
    {
      "sequence_id": 9,
      "text": "JUAN: ¿Cuánto es?"
    },
    {
      "sequence_id": 10,
      "text": "JUAN: How much is it?"
    },
    {
      "sequence_id": 11,
      "text": "CHOF: Dos veinticinco."
    },
    {
      "sequence_id": 12,
      "text": "CHOF: Two twenty-five."
    },
    {
      "sequence_id": 13,
      "text": "JUAN: Aquí tiene, gracias."
    },
    {
      "sequence_id": 14,
      "text": "JUAN: Here you are, thanks."
    },
    {
      "sequence_id": 15,
      "text": "CHOF: Gracias a usted, señor."
    },
