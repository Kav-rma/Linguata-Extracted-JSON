  "articles": [
    {
      "sequence_id": 1,
      "text": "Luz: Hola. ¿Puedo saber de qué están hablando?"
    },
    {
      "sequence_id": 2,
      "text": "Luz: Hello. May I know what you're talking about?"
    },
    {
      "sequence_id": 3,
      "text": "Juan: Estamos hablando de...la fiesta. Está bonita, ¿no te parece?"
    },
    {
      "sequence_id": 4,
      "text": "Juan: We're talking about...the party. It's nice, don't you think?"
    },
    {
      "sequence_id": 5,
      "text": "Luz: Sí, en realidad está estupenda."
    },
    {
      "sequence_id": 6,
      "text": "Luz: Yes, it's really terrific."
    },
    {
      "sequence_id": 7,
      "text": "Juan: ¿Quieres bailar ésta?"
    },
    {
      "sequence_id": 8,
      "text": "Juan: Do you want to dance this one?"
    },
    {
      "sequence_id": 9,
      "text": "Luz: Encantada."
    },
    {
      "sequence_id": 10,
      "text": "Luz: Delighted."
    },
    {
      "sequence_id": 11,
      "text": "Juan: Con permiso. En seguida volvemos."
    },
    {
      "sequence_id": 12,
      "text": "Juan: Excuse us. We'll be right back."
    }
  ],
