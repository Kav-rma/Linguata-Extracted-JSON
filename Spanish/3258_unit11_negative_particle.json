  "articles": [
    {
      "sequence_id": 1,
      "text": "In Spanish, the negative particle *no* is placed immediately before the conjugated verb. It is never placed after the verb or between the subject and verb. For example, *No hablo español* means 'I don't speak Spanish.'"
    }
