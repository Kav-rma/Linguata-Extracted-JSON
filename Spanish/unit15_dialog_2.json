  "questions_and_answers": [],
  "articles": [
    {
      "sequence_id": 1,
      "text": "Jean: Ya estamos listos."
    },
    {
      "sequence_id": 2,
      "text": "Jean: We're ready now."
    },
    {
      "sequence_id": 3,
      "text": "Coronel: Pareces muy contenta. ¿Por qué?"
    },
    {
      "sequence_id": 4,
      "text": "Colonel: You look very happy. Why?"
    },
    {
      "sequence_id": 5,
      "text": "Jean: No me han cobrado nada."
    },
    {
      "sequence_id": 6,
      "text": "Jean: They didn't charge me anything."
    },
    {
      "sequence_id": 7,
      "text": "Coronel: No puedo creerlo, ¿por qué?"
    },
    {
      "sequence_id": 8,
      "text": "Colonel: I can't believe it, why?"
    },
    {
      "sequence_id": 9,
      "text": "Jean: No sé por qué. No me dijeron y yo no voy a preguntarles."
    },
    {
      "sequence_id": 10,
      "text": "Jean: I don't know why. They didn't tell me and I'm not going to ask them."
    },
    {
      "sequence_id": 11,
      "text": "Coronel: ¡Estupendo! Y yo creía que eran rigurosos aquí."
    },
    {
      "sequence_id": 12,
      "text": "Colonel: Terrific! And I thought they were strict here."
    }
  ],
