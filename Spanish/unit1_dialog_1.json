  "articles": [
    {
      "sequence_id": 1,
      "text": "JUAN: Buenos días, José. ¿Cómo está usted?"
    },
    {
      "sequence_id": 2,
      "text": "JUAN: Good morning, José. How are you?"
    },
    {
      "sequence_id": 3,
      "text": "JOSÉ: Muy bien, gracias. ¿Y usted?"
    },
    {
      "sequence_id": 4,
      "text": "JOSÉ: Very well, thank you. And you?"
    },
    {
      "sequence_id": 5,
      "text": "JUAN: Bien, gracias. ¿Adónde va usted?"
    },
    {
      "sequence_id": 6,
      "text": "JUAN: Fine, thanks. Where are you going?"
    },
    {
      "sequence_id": 7,
      "text": "JOSÉ: Voy a la embajada. ¿Y usted?"
    },
    {
      "sequence_id": 8,
      "text": "JOSÉ: I'm going to the embassy. And you?"
    },
    {
      "sequence_id": 9,
      "text": "JUAN: Yo voy al hotel."
    },
    {
      "sequence_id": 10,
      "text": "JUAN: I'm going to the hotel."
    },
    {
      "sequence_id": 11,
      "text": "JOSÉ: Hasta luego, entonces."
    },
    {
      "sequence_id": 12,
      "text": "JOSÉ: See you later, then."
    },
    {
      "sequence_id": 13,
      "text": "JUAN: Adiós, José."
    },
    {
      "sequence_id": 14,
      "text": "JUAN: Goodbye, José."
    }
