  "articles": [
    {
      "sequence_id": 1,
      "text": "MOZO: ¿Le gusta el cuarto?"
    },
    {
      "sequence_id": 2,
      "text": "PORTER: Do you like the room?"
    },
    {
      "sequence_id": 3,
      "text": "WHITE: Sí, me gusta."
    },
    {
      "sequence_id": 4,
      "text": "WHITE: Yes, I do."
    },
    {
      "sequence_id": 5,
      "text": "MOZO: ¿Quiere usted agua mineral?"
    },
    {
      "sequence_id": 6,
      "text": "PORTER: Do you want soda water?"
    },
    {
      "sequence_id": 7,
      "text": "WHITE: Sí. Súbamela después."
    },
    {
      "sequence_id": 8,
      "text": "WHITE: Yes. Bring it up to me later."
    },
    {
      "sequence_id": 9,
      "text": "MOZO: ¿Necesita algo más?"
    },
    {
      "sequence_id": 10,
      "text": "PORTER: Do you need anything else?"
    },
    {
      "sequence_id": 11,
      "text": "WHITE: Sí. ¿Está la Embajada Americana cerca de aquí?"
    },
    {
      "sequence_id": 12,
      "text": "WHITE: Yes. Is the American Embassy near here?"
    },
    {
      "sequence_id": 13,
      "text": "MOZO: No. Está lejos."
    },
    {
      "sequence_id": 14,
      "text": "PORTER: No. It's quite a distance."
    },
    {
      "sequence_id": 15,
      "text": "MOZO: En la avenida de Colón."
    },
    {
      "sequence_id": 16,
      "text": "PORTER: On Columbus Avenue."
    },
    {
      "sequence_id": 17,
      "text": "MOZO: Hay que tomar un taxi."
    },
    {
      "sequence_id": 18,
      "text": "PORTER: It's necessary to take a taxi."
    },
    {
      "sequence_id": 19,
      "text": "WHITE: Gracias. Aquí tiene."
    },
    {
      "sequence_id": 20,
      "text": "WHITE: Thanks. Here you are."
    },
    {
      "sequence_id": 21,
      "text": "MOZO: Muchas gracias, señor."
    },
    {
      "sequence_id": 22,
      "text": "PORTER: Thank you very much, sir."
    },
    {
      "sequence_id": 23,
      "text": "MOZO: ¿Baja en el ascensor?"
    },
    {
      "sequence_id": 24,
      "text": "PORTER: Are you going down in the elevator?"
    },
    {
      "sequence_id": 25,
      "text": "WHITE: Sí, ahora mismo."
    },
    {
      "sequence_id": 26,
      "text": "WHITE: Yes. Right now."
    },
    {
      "sequence_id": 27,
      "text": "WHITE: ¿Dónde está la caja?"
    },
    {
      "sequence_id": 28,
      "text": "WHITE: Where's the cashier's desk?"
    },
    {
      "sequence_id": 29,
      "text": "MOZO: En el primer piso, a la derecha de la entrada."
    },
    {
      "sequence_id": 30,
      "text": "PORTER: On the first floor to the right of the entrance."
    },
    {
      "sequence_id": 31,
      "text": "WHITE: ¿Puede cambiarme unos dólares?"
    },
    {
      "sequence_id": 32,
      "text": "WHITE: Can you change a few dollars for me?"
    },
    {
      "sequence_id": 33,
      "text": "CAJERO: Sí. ¿Cuántos?"
    },
    {
      "sequence_id": 34,
      "text": "CASHIER: Yes. How many?"
    },
    {
      "sequence_id": 35,
      "text": "WHITE: Diez. ¿A cómo está el cambio?"
    },
    {
      "sequence_id": 36,
      "text": "WHITE: Ten. What's the rate of exchange?"
    },
    {
      "sequence_id": 37,
      "text": "CAJERO: ¿En billetes o en cheque?"
    },
    {
      "sequence_id": 38,
      "text": "CASHIER: In bills or in a check?"
    },
    {
      "sequence_id": 39,
      "text": "WHITE: Este cheque viajero."
    },
    {
      "sequence_id": 40,
      "text": "WHITE: This traveler's check."
    },
    {
      "sequence_id": 41,
      "text": "CAJERO: A cinco por uno, entonces."
    },
    {
      "sequence_id": 42,
      "text": "CASHIER: Five to one, then."
    },
    {
      "sequence_id": 43,
      "text": "CAJERO: ¿Cómo lo quiere?"
    },
    {
      "sequence_id": 44,
      "text": "CASHIER: How do you want it?"
    },
    {
      "sequence_id": 45,
      "text": "WHITE: Ocho en billetes y dos en moneda."
    },
    {
      "sequence_id": 46,
      "text": "WHITE: Eight in bills and two in change."
    },
    {
      "sequence_id": 47,
      "text": "WHITE: ¿Cuánto cuesta un taxi a la Embajada Americana?"
    },
    {
      "sequence_id": 48,
      "text": "WHITE: How much does a taxi to the American Embassy cost?"
    },
    {
      "sequence_id": 49,
      "text": "CAJERO: Dos pesos más o menos."
    },
    {
      "sequence_id": 50,
      "text": "CASHIER: Two pesos more or less."
    },
    {
      "sequence_id": 51,
      "text": "WHITE: Gracias por la información."
    },
    {
      "sequence_id": 52,
      "text": "WHITE: Thanks for the information."
    },
    {
      "sequence_id": 53,
      "text": "JUAN: Dispense, ¿a cómo está el cambio?"
    },
    {
      "sequence_id": 54,
      "text": "JUAN: Excuse me, what's the rate of exchange?"
    },
    {
      "sequence_id": 55,
      "text": "CAJERO: Está a tres por uno."
    },
    {
      "sequence_id": 56,
      "text": "CASHIER: It's three to one."
    },
    {
      "sequence_id": 57,
      "text": "JUAN: ¿Puede cambiarme este billete?"
    },
    {
      "sequence_id": 58,
      "text": "JUAN: Can you change this bill?"
    },
    {
      "sequence_id": 59,
      "text": "CAJERO: ¿De cuánto es?"
    },
    {
      "sequence_id": 60,
      "text": "CASHIER: How much is it?"
    },
    {
      "sequence_id": 61,
      "text": "JUAN: Es de veinte dólares."
    },
    {
      "sequence_id": 62,
      "text": "JUAN: It's twenty dollars."
    },
    {
      "sequence_id": 63,
      "text": "CAJERO: Con mucho gusto. ¿Cómo lo quiere?"
    },
    {
      "sequence_id": 64,
      "text": "CASHIER: With pleasure. How do you want it?"
    },
    {
      "sequence_id": 65,
      "text": "JUAN: Dos de veinte y dos de diez, por favor."
    },
    {
      "sequence_id": 66,
      "text": "JUAN: Two twenties and two tens, please."
    },
    {
      "sequence_id": 67,
      "text": "CAJERO: Cómo no, aquí tiene."
    },
    {
      "sequence_id": 68,
      "text": "CASHIER: Certainly, here you are."
    },
    {
      "sequence_id": 69,
      "text": "JUAN: Lléveme a la Embajada Americana."
    },
    {
      "sequence_id": 70,
      "text": "JUAN: Take me to the American Embassy."
    },
    {
      "sequence_id": 71,
      "text": "CHOFER: Perdón, ¿cómo dice?"
    },
    {
      "sequence_id": 72,
      "text": "DRIVER: Excuse me, what did you say?"
    },
    {
      "sequence_id": 73,
      "text": "JUAN: A la Embajada Americana. ¿Está muy lejos de aquí?"
    },
    {
      "sequence_id": 74,
      "text": "JUAN: To the American Embassy. Is it far from here?"
    },
    {
      "sequence_id": 75,
      "text": "CHOFER: No mucho, está en la Avenida Colón."
    },
    {
      "sequence_id": 76,
      "text": "DRIVER: Not very, it's on Columbus Avenue."
    },
    {
      "sequence_id": 77,
      "text": "JUAN: ¿Cuánto es?"
    },
    {
      "sequence_id": 78,
      "text": "JUAN: How much is it?"
    },
    {
      "sequence_id": 79,
      "text": "CHOFER: Dos veinticinco."
    },
    {
      "sequence_id": 80,
      "text": "DRIVER: Two twenty-five."
    },
    {
      "sequence_id": 81,
      "text": "JUAN: Aquí tiene, gracias."
    },
    {
      "sequence_id": 82,
      "text": "JUAN: Here you are, thanks."
    },
    {
      "sequence_id": 83,
      "text": "CHOFER: Gracias a usted, señor."
