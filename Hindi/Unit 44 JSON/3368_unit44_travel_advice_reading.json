  "articles": [
    {
      "sequence_id": 1,
      "text": "आपको भारत जाने की सलाह किसने दी थी ?"
    },
    {
      "sequence_id": 2,
      "text": "मेरे एक बड़े गहरे मित्र ने ।"
    },
    {
      "sequence_id": 3,
      "text": "उन्होंने मुझे भारत के बारे में बहुत-सी बातें सुनाई थीं जो मुझे बहुत अच्छी लगीं ।"
    },
    {
      "sequence_id": 4,
      "text": "उन्होंने उस समय यह भी कहा था कि अगर कभी पैसा और समय हो तो भारत ज़रूर जाइये ।"
    },
    {
      "sequence_id": 5,
      "text": "तो आपने जाने और वहाँ ठहरने का सब प्रबंध कैसे किया था ?"
    },
    {
      "sequence_id": 6,
      "text": "मैंने सबसे पहले अपने बैंक के मैनेजर से बात की ।"
    },
    {
      "sequence_id": 7,
      "text": "उन्होंने कहा कि क़र्ज़ मिल सकता है ।"
    },
    {
      "sequence_id": 8,
      "text": "उसके बाद मैंने अपने एक और मित्र को अपना सारा कार्यक्रम लिख दिया ।"
    },
    {
      "sequence_id": 9,
      "text": "उन्होंने मेरा सब प्रबंध कर दिया और मैं बड़े आराम से भारत घूम लिया ।"
    }
  ],
