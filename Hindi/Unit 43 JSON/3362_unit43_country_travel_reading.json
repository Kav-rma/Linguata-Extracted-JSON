  "articles": [
    {
      "sequence_id": 1,
      "text": "क्या आपने ताजमहल देखा है ?"
    },
    {
      "sequence_id": 2,
      "text": "जी हाँ, मैंने देखा है । बड़ी सुन्दर इमारत है ।"
    },
    {
      "sequence_id": 3,
      "text": "आपने और कौन कौन से देश देखे हैं ?"
    },
    {
      "sequence_id": 4,
      "text": "एशिया में मैंने केवल भारत, नेपाल और पाकिस्तान देखे हैं ।"
    },
    {
      "sequence_id": 5,
      "text": "लेकिन यूरोप में बहुत यात्रा की है ।"
    },
    {
      "sequence_id": 6,
      "text": "क्या आप अकेले गये थे ?"
    },
    {
      "sequence_id": 7,
      "text": "जी नहीं ! मेरे एक दोस्त भी मेरे साथ गये थे ।"
    },
    {
      "sequence_id": 8,
      "text": "मैंने उन्हें कल यहाँ बुलवाया है ।"
    },
    {
      "sequence_id": 9,
      "text": "शायद उन्होंने अपना दूसरा मकान बनवाया है इसलिए उन्हें बहुत कम फुर्सत मिलती है ।"
    },
    {
      "sequence_id": 10,
      "text": "अगर आप कल आ सकें तो बड़ी कृपा होगी ।"
    },
    {
      "sequence_id": 11,
      "text": "अच्छी बात । आपका बड़ा धन्यवाद ।"
    },
    {
      "sequence_id": 12,
      "text": "अब मैं कल आपके दर्शन करूंगा ।"
    }
  ],
