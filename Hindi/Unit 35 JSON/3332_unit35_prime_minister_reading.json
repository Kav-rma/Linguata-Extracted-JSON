  "articles": [
    {
      "sequence_id": 1,
      "text": "आपके विचार में ब्रिटेन के प्रधानमंत्री आज कहां ठहरेंगे ?"
    },
    {
      "sequence_id": 2,
      "text": "वे हमारे राष्ट्रपति के साथ राष्ट्रपति-भवन में ठहरेंगे ।"
    },
    {
      "sequence_id": 3,
      "text": "वे यहां तीन दिन तक रहेंगे ।"
    },
    {
      "sequence_id": 4,
      "text": "उसके बाद वे कहाँ जायेंगे ?"
    },
    {
      "sequence_id": 5,
      "text": "वे फिर कनाडा और दक्षिण-अमेरिकी देशों का दौरा करेंगे ।"
    },
    {
      "sequence_id": 6,
      "text": "मेरी समझ में उनका दौरा बहुत महत्त्वपूर्ण होगा ।"
    },
    {
      "sequence_id": 7,
      "text": "कुछ देशों में वे नई व्यापार-संधियों के बारे में बातचीत करेंगे ।"
    },
    {
      "sequence_id": 8,
      "text": "क्या हमारे राष्ट्रपति भी इस साल विदेश यात्रा पर जायेंगे ?"
    },
    {
      "sequence_id": 9,
      "text": "जी हाँ, जायेंगे !"
    },
    {
      "sequence_id": 10,
      "text": "वे लगभग ग्यारह देशों का दौरा पन्द्रह दिनों में समाप्त करेंगे ।"
    },
    {
      "sequence_id": 11,
      "text": "उनके साथ उनकी पत्नी और दोनों बेटियाँ भी जायेंगी ।"
    },
    {
      "sequence_id": 12,
      "text": "आपका प्रधानमंत्री हमारे देश के दौरे पर कब जायेंगे ?"
    },
    {
      "sequence_id": 13,
      "text": "क्या वे और कहीं भी जायेंगे ?"
    }
  ],
