  "articles": [
    {
      "sequence_id": 1,
      "text": "सवेरे कितने बजे घर से चलती हैं ?"
    },
    {
      "sequence_id": 2,
      "text": "मैं साढ़े आठ बजे चलती हूं और नौ बजे पहुंचती हूं ।"
    },
    {
      "sequence_id": 3,
      "text": "वहां क्या करती हैं ?"
    },
    {
      "sequence_id": 4,
      "text": "हिंदी पढ़ती हूं । सिर्फ हिंदी ।"
    },
    {
      "sequence_id": 5,
      "text": "क्या आपके बच्चे स्कूल जाते हैं ।"
    },
    {
      "sequence_id": 6,
      "text": "जी हां, रोज सवेरे जाते हैं ।"
    },
    {
      "sequence_id": 7,
      "text": "छोटा बच्चा एक बजे वापस आता है और दूसरा साढ़े तीन बजे"
    },
    {
      "sequence_id": 8,
      "text": "दोपहर को क्या करते हैं ?"
    },
    {
      "sequence_id": 9,
      "text": "विनोद सोता है, लेकिन बड़ा लड़का टेनिस खेलता है ।"
    }
  ],
