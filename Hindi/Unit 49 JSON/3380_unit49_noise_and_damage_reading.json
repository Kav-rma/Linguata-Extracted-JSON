  "articles": [
    {
      "sequence_id": 1,
      "text": "कल रात आपके घर में इतना शोर क्यों हो रहा था ?"
    },
    {
      "sequence_id": 2,
      "text": "कल रात जब आंधी चली तो हमारी दोनों खिड़कियाँ खुल गईं और तस्वीरें फर्श पर गिरकर टूट गईं ।"
    },
    {
      "sequence_id": 3,
      "text": "बड़ा नुक़सान हुआ ।"
    },
    {
      "sequence_id": 4,
      "text": "मैंने समझा कि आपके बच्चों ने कुछ कर दिया ?"
    },
    {
      "sequence_id": 5,
      "text": "जी नहीं, उन्होंने कुछ नहीं किया । हां मुझसे कल एक गलती हो गई । मुझसे आपकी घड़ी टूट गई ।"
    },
    {
      "sequence_id": 6,
      "text": "मैंने बनवाने की बहुत कोशिश की पर बन न सकी । चिंता न कीजिये । मैं आपके लिये एक नई ला दूंगा ।"
    },
    {
      "sequence_id": 7,
      "text": "क्या आपने अपना फ़र्नीचर कहाँ बनवाया था ?"
    },
    {
      "sequence_id": 8,
      "text": "जी नहीं, बनवाया नहीं। हमने बना-बनाया खरीदा था।"
    },
    {
      "sequence_id": 9,
      "text": "हमारे दोस्त ने अपने एक मिलने वाले की दुकान से खरीदा था ।"
    }
  ],
