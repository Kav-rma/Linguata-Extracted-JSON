  "articles": [
    {
      "sequence_id": 1,
      "text": "देशों में और देशों के बीच शांति कैसे स्थापित की जा सकती है ?"
    },
    {
      "sequence_id": 2,
      "text": "शांति स्थापित करना आसान काम नहीं है । शांति स्थापित करने के लिये बहुत से उपाय काम में लाये जा सकते हैं ।"
    },
    {
      "sequence_id": 3,
      "text": "विद्यार्थियों में अराजकता न फैलने दी जानी चाहिये ।"
    },
    {
      "sequence_id": 4,
      "text": "मजदूरों को उचित मजदूरी दी जाये ।"
    },
    {
      "sequence_id": 5,
      "text": "ग्राम जनता की साधारण सुविधाओं पर भी पूरा ध्यान दिया जाना चाहिये ।"
    },
    {
      "sequence_id": 6,
      "text": "इस प्रकार की बातों पर यदि हर देश में इस पर ध्यान दिया जाता तो आज संसार की यह दशा न होती ।"
    },
    {
      "sequence_id": 7,
      "text": "कहा जाता है कि जिन कुछ देशों में इन पर पूरा ध्यान दिया गया उनमें लगभग शांति पाई जाती है ।"
    },
    {
      "sequence_id": 8,
      "text": "इन्हीं तरीकों से देशों के बीच में शांति स्थापित की जा सकती है ।"
    }
  ],
