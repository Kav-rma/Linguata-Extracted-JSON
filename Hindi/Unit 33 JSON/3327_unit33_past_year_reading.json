      "sequence_id": 1,
      "text": "पिछले साल उस देश में क्या हो रहा था ?"
    },
    {
      "sequence_id": 2,
      "text": "वहाँ काफी गड़बड़ हो रही थी ।"
    },
    {
      "sequence_id": 3,
      "text": "स्कूलों और कॉलेजों में बहुत कम पढ़ाई हो रही थी ।"
    },
    {
      "sequence_id": 4,
      "text": "बहुत लोग दूसरे देशों में जाने की कोशिश कर रहे थे ।"
    },
    {
      "sequence_id": 5,
      "text": "हम सब लोग चुपचाप सब कुछ देख रहे थे ।"
    },
    {
      "sequence_id": 6,
      "text": "किसी चीज़ में हिस्सा नहीं ले रहे थे ।"
    },
    {
      "sequence_id": 7,
      "text": "आप दोनों वहाँ कब से काम कर रहे थे ?"
    },
    {
      "sequence_id": 8,
      "text": "हम लोग उस दफ्तर में लगभग ढाई साल से काम कर रहे थे ।"
    },
    {
      "sequence_id": 9,
      "text": "हमारे कुछ साथी वहाँ पांच छह साल से काम कर रहे थे ।"
    },
    {
      "sequence_id": 10,
      "text": "हम सबको अपना काम काफी पसंद था लेकिन इस प्रकार की अशांति पसंद नहीं थी ।"
    },
    {
      "sequence_id": 11,
      "text": "क्या आपके देश में और आपके पड़ोसी देशों में भी इस किस्म की अशांति हो रही थी ?"
