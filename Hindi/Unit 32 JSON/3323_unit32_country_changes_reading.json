  "articles": [
    {
      "sequence_id": 1,
      "text": "आजकल आपके देश में क्या हो रहा है ?"
    },
    {
      "sequence_id": 2,
      "text": "बहुत चीजें हो रही हैं ।"
    },
    {
      "sequence_id": 3,
      "text": "एक तरफ़ देश में पहले से बहुत अधिक अन्न पैदा हो रहा है ।"
    },
    {
      "sequence_id": 4,
      "text": "दूसरी तरफ़ कई विश्वविद्यालयों में हड़ताले हो रही हैं ।"
    },
    {
      "sequence_id": 5,
      "text": "देश में हर किस्म की तरक्की हो रही है ।"
    },
    {
      "sequence_id": 6,
      "text": "लोग नई से नई मशीनें चलाना सीख रहे हैं ।"
    },
    {
      "sequence_id": 7,
      "text": "बाहर के देशों से कुछ लोग यहाँ पढ़ने आ रहे हैं ।"
    },
    {
      "sequence_id": 8,
      "text": "अब आप बताइये कि आप यहाँ कब से काम कर रहे हैं ?"
    }
  ],
