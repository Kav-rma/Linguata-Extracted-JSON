    {
      "sequence_id": 1,
      "text": "कल आप लोग कहाँ गये थे ?"
    },
    {
      "sequence_id": 2,
      "text": "कल सवेरे हम लोग हवाई अड्डे पर गये थे ।"
    },
    {
      "sequence_id": 3,
      "text": "मेरा छोटा लड़का कल नेपाल गया ।"
    },
    {
      "sequence_id": 4,
      "text": "शाम को हम लोग सिनेमा देखने गये थे ।"
    },
    {
      "sequence_id": 5,
      "text": "वापसी में कुछ देर हम अपने दोस्त के घर ठहरे ।"
    },
    {
      "sequence_id": 6,
      "text": "फिर वे भी हमारे साथ हमारे यहाँ खाना खाने आये ।"
    }
