    {
      "sequence_id": 1,
      "text": "आइये, चलिये कॉफ़ी पीने चलें ?"
    },
    {
      "sequence_id": 2,
      "text": "धन्यवाद, मैं पी चुका हूँ। आप जाकर पी लीजिये।"
    },
    {
      "sequence_id": 3,
      "text": "मैं अकेले नहीं पीता। अकेले पीने में मज़ा नहीं आता।"
    },
    {
      "sequence_id": 4,
      "text": "आप रोज़ तो इस समय तक पी नहीं चुके थे ?"
    },
    {
      "sequence_id": 5,
      "text": "आज क्या हुआ ?"
    },
    {
      "sequence_id": 6,
      "text": "आज मैं सवेरे आठ बजे से पहले ही दफ़्तर पहुँच चुका था इसलिए दो घंटे के बाद मैंने नीचे जाकर पी ली।"
    },
    {
      "sequence_id": 7,
      "text": "जब आप कॉफी पी चुके तो मेरे दफ़्तर में आइये।"
    },
    {
      "sequence_id": 8,
      "text": "आशा है कि उस समय तक मैं भी अपना जरूरी काम खत्म कर चुका हूँ और फिर हम दोनों कुछ बातें कर सकेंगे।"
    }
