  "articles": [
    {
      "sequence_id": 1,
      "text": "उनके कितने बच्चे हैं ?"
    },
    {
      "sequence_id": 2,
      "text": "पाँच हैं, दो लड़के और तीन लड़कियां ।"
    },
    {
      "sequence_id": 3,
      "text": "उनमें सबसे बड़ा कौन है ?"
    },
    {
      "sequence_id": 4,
      "text": "लड़का सबसे बड़ा है ।"
    },
    {
      "sequence_id": 5,
      "text": "उससे छोटी दो लड़कियां हैं ।"
    },
    {
      "sequence_id": 6,
      "text": "चौथा लड़का है और पाँचवी लड़की ।"
    },
    {
      "sequence_id": 7,
      "text": "आपकी बड़ी बहन कहाँ रहती है ?"
    },
    {
      "sequence_id": 8,
      "text": "वे बम्बई में रहती हैं ।"
    },
    {
      "sequence_id": 9,
      "text": "क्या वे शादीशुदा हैं ?"
    },
    {
      "sequence_id": 10,
      "text": "जी हाँ, वे शादीशुदा हैं और उनके दो बच्चे हैं,"
    },
    {
      "sequence_id": 11,
      "text": "लड़के या लड़कियां ?"
    },
    {
      "sequence_id": 12,
      "text": "दोनों लड़कियां हैं ।"
    }
