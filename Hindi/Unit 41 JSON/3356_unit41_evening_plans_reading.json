  "articles": [
    {
      "sequence_id": 1,
      "text": "आज शाम को आप क्या कर रहे हैं ?"
    },
    {
      "sequence_id": 2,
      "text": "कुछ नहीं। कहिये तो आपके साथ कहाँ चलूँ ?"
    },
    {
      "sequence_id": 3,
      "text": "जी हाँ, चलिये आज सिनेमा देखने चलें। बच्चों को भी ले लें ?"
    },
    {
      "sequence_id": 4,
      "text": "ज़रूर! अगर आप बुरा न मानें तो छोटे बच्चे को एक खिलौना ले दूँ ?"
    },
    {
      "sequence_id": 5,
      "text": "हाँ हाँ, ले दीजिये। शायद उसे आपका खिलौना बहुत पसंद आये ।"
    },
    {
      "sequence_id": 6,
      "text": "बड़े बच्चे को कुछ पैसे दे दें ?"
    },
    {
      "sequence_id": 7,
      "text": "पैसे न दें तो अच्छा होगा। पैसों से बच्चों की आदत खराब होती है ।"
    }
  ],
