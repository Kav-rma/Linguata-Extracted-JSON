  "articles": [
    {
      "sequence_id": 1,
      "text": "आपके विचार में भारत के लोग इस समय क्या कर रहे होंगे ?"
    },
    {
      "sequence_id": 2,
      "text": "इस समय यहाँ सवेरे के नौ बजे हैं सो वहाँ रात के साढ़े दस बजे होंगे ।"
    },
    {
      "sequence_id": 3,
      "text": "कुछ लोग सो चुके होंगे ।"
    },
    {
      "sequence_id": 4,
      "text": "कुछ सोने की तैयारियाँ कर रहे होंगे और कुछ सिनेमा देखने गये होंगे ।"
    },
    {
      "sequence_id": 5,
      "text": "आज आपके मित्र आने वाले थे न ? कब पहुँचेंगे ?"
    },
    {
      "sequence_id": 6,
      "text": "पहुँचते ही होंगे । शायद कहीं रास्ते में आराम करते होंगे इसलिए अभी तक यहाँ नहीं पहुँचे ।"
    },
    {
      "sequence_id": 7,
      "text": "क्या उन्होंने मेरा पत्र लिख दिया होगा ?"
    },
    {
      "sequence_id": 8,
      "text": "क्या मैं जाकर पूछूँ ?"
    },
    {
      "sequence_id": 9,
      "text": "हाँ, मेरी समझ से लिख दिया होगा । वे अपना काम कल दिन में समाप्त कर चुके थे इसलिए मुझे पूरा विश्वास है कि आपकी चिट्ठी भी लिख दी होगी ।"
    }
  ],
