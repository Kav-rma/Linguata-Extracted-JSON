  "articles": [
    {
      "sequence_id": 1,
      "text": "क्या आपके दोस्तों को आज अपना वेतन चाहिए?"
    },
    {
      "sequence_id": 2,
      "text": "जी हां, जरूर चाहिए ।"
    },
    {
      "sequence_id": 3,
      "text": "उन्हें कुछ दिनों की छुट्टी भी चाहिए ।"
    },
    {
      "sequence_id": 4,
      "text": "उनसे पूछिये कि कम से कम कितनी चाहिए ?"
    },
    {
      "sequence_id": 5,
      "text": "कम से कम तीन दिन की जरूर चाहिए ।"
    },
    {
      "sequence_id": 6,
      "text": "अगले महीने में आप लोगों को क्या खरीदना चाहिए ?"
    },
    {
      "sequence_id": 7,
      "text": "भारत जाने से पहले हमें नई गाड़ी खरीदनी चाहिए ।"
    },
    {
      "sequence_id": 8,
      "text": "उसके बाद बच्चों के लिए एक स्कूटर भी खरीदना चाहिए ।"
    },
    {
      "sequence_id": 9,
      "text": "बच्चों की सवारी के लिए कुछ न कुछ जरूर चाहिए ।"
    },
    {
      "sequence_id": 10,
      "text": "आपका क्या विचार है ?"
    }
