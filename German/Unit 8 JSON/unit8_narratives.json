  "articles": [
    {
      "sequence_id": 1,
      "text": "Herr und Frau Jones machen einen Spaziergang durch das Geschäftszentrum Düsseldorfs."
    },
    {
      "sequence_id": 2,
      "text": "Die Schaufensterauslagen gefallen ihnen sehr gut und Frau Jones bleibt lange vor dem Schaufenster eines Damenmodegeschäfts stehen."
    },
    {
      "sequence_id": 3,
      "text": "Ihr gefallen die schönen Kleider, Pullover, Strickjacken und Blusen."
    },
    {
      "sequence_id": 4,
      "text": "Die Handschuhe, Handtasche und Strümpfe harmonieren mit der Kleidung."
    },
    {
      "sequence_id": 5,
      "text": "Herr Jones interessiert sich mehr für die Herrenmode."
    },
    {
      "sequence_id": 6,
      "text": "Sie ist in Deutschland etwas konservativer als in Amerika."
    },
    {
      "sequence_id": 7,
      "text": "Helle gelbe Socken, feuerrote Pullover oder schreiend-bunte Krawatten findet man nicht sehr oft."
    },
    {
      "sequence_id": 8,
      "text": "Viele Herren kaufen ihre Anzüge auch heute noch beim Schneider."
    },
    {
      "sequence_id": 9,
      "text": "Man kann aber auch sehr gute Anzüge von der Stange kaufen."
    },
    {
      "sequence_id": 10,
      "text": "Die Bedienung in den Geschäften ist gewöhnlich sehr höflich und aufmerksam."
    },
    {
      "sequence_id": 11,
      "text": "Die Verkäufer haben eine lange Ausbildungszeit."
    },
    {
      "sequence_id": 12,
      "text": "So viele Ausverkäufe wie in Amerika gibt es in Deutschland nicht."
    },
    {
      "sequence_id": 13,
      "text": "Ausverkäufe sind gesetzlich geregelt."
    },
    {
      "sequence_id": 14,
      "text": "Aber in allen Städten gibt es einen Sommerschlussverkauf und einen Winterschlussverkauf."
    },
    {
      "sequence_id": 15,
      "text": "Herr und Frau Jones gehen auch in ein Schuhgeschäft."
    },
    {
      "sequence_id": 16,
      "text": "Die Schuhe in den Schaufenstern sind nicht nummeriert."
    },
    {
      "sequence_id": 17,
      "text": "Im Geschäft müssen sie dem Verkäufer sagen, was sie haben wollen."
    },
    {
      "sequence_id": 18,
      "text": "Dieser zeigt ihnen dann mehrere Paar Schuhe, und Herr Jones findet auch bald etwas, was ihm gefällt."
    }
  ],
