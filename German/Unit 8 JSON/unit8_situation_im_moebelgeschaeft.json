    "articles": [
      {
        "sequence_id": 1,
        "text": "Jones' wollen sich neue Möbel kaufen."
      },
      {
        "sequence_id": 2,
        "text": "Sie fragen Herrn Schmidt, wo ein gutes Möbelgeschäft ist."
      },
      {
        "sequence_id": 3,
        "text": "Herr Schmidt sagt ihnen, er kauft gern bei Schneider und Co."
      },
      {
        "sequence_id": 4,
        "text": "Das ist ein gutes altes Geschäft in der Bahnhofstrasse."
      },
      {
        "sequence_id": 5,
        "text": "Herr und Frau Jones gehen dorthin und sehen sich Wohnzimmer-Möbel an."
      },
      {
        "sequence_id": 6,
        "text": "Sie kaufen sich einen Schreibtisch, einen grossen Sessel, einen Bücherschrank, vier Stühle, ein Sofa, eine Stehlampe und einen kleinen Rauchtisch."
      },
      {
        "sequence_id": 7,
        "text": "Dann zeigt ihnen der Verkäufer noch einige schöne Teppiche."
      },
      {
        "sequence_id": 8,
        "text": "Aber die Teppiche sind sehr teuer und Herr und Frau Jones wollen sich noch keinen kaufen."
      }
