    "articles": [
      {
        "sequence_id": 1,
        "text": "Die Arznei macht kranke, die Mathematik traurige und die Theologie sündhafte Leute."
      },
      {
        "sequence_id": 2,
        "text": "Arzt, hilf dir selber."
      },
      {
        "sequence_id": 3,
        "text": "Der Arzt sieht den Menschen in seiner ganzen Schwäche, der Advokat in seiner ganzen Schlechtigkeit und der Priester in seiner ganzen Dummheit."
      },
      {
        "sequence_id": 4,
        "text": "Hier ruht ein Arzt, Herr Dr. Frumm, und die er heilte, ringsherum."
      },
      {
        "sequence_id": 5,
        "text": "Welchen Arzt ich habe?"
      },
      {
        "sequence_id": 6,
        "text": "Frage lieber, welcher Arzt mich hat."
      },
      {
        "sequence_id": 7,
        "text": "Die Gesunden bedürfen des Arztes nicht, sondern die Kranken."
      },
      {
        "sequence_id": 8,
        "text": "Ein neuer Doktor, ein neuer Kirchhof."
      },
      {
        "sequence_id": 9,
        "text": "Der Geist der Medizin ist leicht zu fassen;"
      },
      {
        "sequence_id": 10,
        "text": "Ihr durchstudiert die gross' und kleine Welt,"
      },
      {
        "sequence_id": 11,
        "text": "um es am Ende gehn zu lassen,"
      },
      {
        "sequence_id": 12,
        "text": "Wie's Gott gefällt."
      },
      {
        "sequence_id": 13,
        "text": "Soviel Zellen die Gewebe meines langen Leibs enthalten,"
      },
      {
        "sequence_id": 14,
        "text": "In so viele Muskelfasern sich mein sterblich Fleisch lässt spalten,"
      },
      {
        "sequence_id": 15,
        "text": "Soviel kleine Blutgefässe mich vom Kopf zum Fuss durchziehen,"
      },
      {
        "sequence_id": 16,
        "text": "Soviel Körperchen in ihnen heissen roten Blutes glühen,"
      },
      {
        "sequence_id": 17,
        "text": "Soviel mal in hundert Pfunden Fleisch sich kapselt die Trichine:"
      },
      {
        "sequence_id": 18,
        "text": "Soviel mal, du schlanke Palme, lieb' ich dich, O Josephine:"
      }
