  "articles": [
    {
      "sequence_id": 1,
      "text": "Herr Allen wird von Herrn Bauer im Hotel abgeholt."
    },
    {
      "sequence_id": 2,
      "text": "Herr Bauer freut sich, Herrn Allen wiederzusehen und möchte wissen, wie es seiner Familie geht."
    },
    {
      "sequence_id": 3,
      "text": "Frau Allen und den Kindern geht es gut."
    },
    {
      "sequence_id": 4,
      "text": "Auf seiner Reise hat alles gut geklappt."
    },
    {
      "sequence_id": 5,
      "text": "Herr Bauer fragt, wann Herr Allen aus Amerika abgefahren ist und welche Länder er inzwischen besucht hat."
    },
    {
      "sequence_id": 6,
      "text": "Herr Allen ist schon einen Monat unterwegs."
    },
    {
      "sequence_id": 7,
      "text": "Zuerst besuchte er Finnland, wo bei seinen Freunden gerade eine Jagd war."
    },
    {
      "sequence_id": 8,
      "text": "Finnland hat ja sehr viel Wild."
    },
    {
      "sequence_id": 9,
      "text": "Dann besichtigte er einige Betriebe der Papierindustrie."
    },
    {
      "sequence_id": 10,
      "text": "Das war sehr interessant für ihn."
    },
    {
      "sequence_id": 11,
      "text": "Herr Bauer will wissen, ob er von dort nach Norwegen gefahren ist."
    },
    {
      "sequence_id": 12,
      "text": "Herr Allen verbrachte einige Tage dort und fuhr dann weiter nach Schweden."
    },
    {
      "sequence_id": 13,
      "text": "Es hat ihm dort gut gefallen."
    },
    {
      "sequence_id": 14,
      "text": "Die Leute waren sehr nett, die Städte sind sauber und modern."
    },
    {
      "sequence_id": 15,
      "text": "Schön sind auch die grossen Waldgebiete."
    },
    {
      "sequence_id": 16,
      "text": "Sie sind sehr wichtig für die Industrie in Schweden."
    },
    {
      "sequence_id": 17,
      "text": "Herr Bauer möchte wissen, ob Herr Allen von Schweden direkt nach Berlin kam."
    },
    {
      "sequence_id": 18,
      "text": "Herr Allen hatte erst noch einen Abstecher nach Dänemark gemacht."
    },
    {
      "sequence_id": 19,
      "text": "Dieses Land machte auch einen sehr sauberen und ordentlichen Eindruck."
    },
    {
      "sequence_id": 20,
      "text": "Besonders gut gefiel ihm eine Autofahrt an die Ostsee."
    },
    {
      "sequence_id": 21,
      "text": "Herr Bauer fragt, ob Herr Allen auch in dem bekannten Tivoli Park in Kopenhagen war."
    },
    {
      "sequence_id": 22,
      "text": "Dazu hatte Herr Allen keine Zeit mehr, er musste zu einer Tagung nach Hamburg fahren."
    }
  ],
