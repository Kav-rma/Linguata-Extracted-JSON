  "articles": [
    {
      "sequence_id": 1,
      "text": "Die beiden Herren treffen sich im Hotel und Herr Becker fragt, ob Herr Jones eine gute Reise hatte."
    },
    {
      "sequence_id": 2,
      "text": "Leider hatte er unterwegs eine Reifenpanne, aber glücklicherweise war eine Tankstelle in der Nähe und er konnte gleich den Reifen wechseln lassen."
    },
    {
      "sequence_id": 3,
      "text": "Nun wollen sich die Herren die Stadt ansehen."
    },
    {
      "sequence_id": 4,
      "text": "Zuerst fahren sie zur Frauenkirche und Herr Becker erzählt Herrn Jones, dass diese Kirche aus dem 15. Jahrhundert ist."
    },
    {
      "sequence_id": 5,
      "text": "Sie wurde im Krieg leider zerstört, ist aber bald nach dem Kriege wiederaufgebaut worden."
    },
    {
      "sequence_id": 6,
      "text": "In der Nähe ist das Rathaus; Herr Jones hatte das schon oft auf Bildern gesehen."
    },
    {
      "sequence_id": 7,
      "text": "Dann fahren sie zum Schloss Nymphenburg und gehen im Park spazieren."
    },
    {
      "sequence_id": 8,
      "text": "Sie unterhalten sich über die Konferenz und über eine interessante Ausstellung in der Stadt."
    },
    {
      "sequence_id": 9,
      "text": "Da das Wetter so schön ist und sie auch noch genug Zeit haben, wollen sie sich noch den Tierpark Hellabrunn ansehen."
    },
    {
      "sequence_id": 10,
      "text": "Sie trinken im Gartenrestaurant des Tierparks ein Glas Bier und fahren später zum Hotel zurück."
    }
  ],
