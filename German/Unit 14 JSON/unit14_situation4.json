    "articles": [
      {
        "sequence_id": 1,
        "text": "Sie erzählen Ihren Kollegen von Ihrer Reise nach Berlin."
      },
      {
        "sequence_id": 2,
        "text": "Eine ganze Menge ist schiefgegangen."
      },
      {
        "sequence_id": 3,
        "text": "Sie hatten verschlafen und fast den Zug verpasst, weil Sie noch keine Fahrkarte gelöst hatten."
      },
      {
        "sequence_id": 4,
        "text": "Ihr Gepäck war sehr schwer und Sie konnten keinen Gepäckträger finden."
      },
      {
        "sequence_id": 5,
        "text": "Nachdem Sie endlich im Zug saßen, fiel Ihnen ein, dass Sie Ihre Aktenmappe im Büro gelassen hatten."
      },
      {
        "sequence_id": 6,
        "text": "Glücklicherweise hatte Ihre Sekretärin sie gefunden und sie schnell noch zum Zug gebracht."
      },
      {
        "sequence_id": 7,
        "text": "Nachdem der Zug abgefahren war, sahen Sie, dass Sie vergessen hatten, sich Reiseliteratur zu besorgen."
      },
      {
        "sequence_id": 8,
        "text": "Als Sie in Berlin ankamen, fuhren Sie mit einer Taxe zum Hotel."
      },
      {
        "sequence_id": 9,
        "text": "Sie hatten sich dort telegraphisch ein Zimmer reservieren lassen."
      },
      {
        "sequence_id": 10,
        "text": "Leider hatte der Empfangschef vergessen, es zu reservieren."
      },
      {
        "sequence_id": 11,
        "text": "Er hatte aber noch ein Zimmer - ohne Bad - im achten Stock frei."
      },
      {
        "sequence_id": 12,
        "text": "Am nächsten Tag gingen Sie zu einer Konferenz."
      },
      {
        "sequence_id": 13,
        "text": "Leider hörten Sie, dass diese schon vor acht Tagen stattgefunden hatte."
      },
      {
        "sequence_id": 14,
        "text": "Jetzt sind Sie froh, dass Sie wieder zu Hause sind."
      }
