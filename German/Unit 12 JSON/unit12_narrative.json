    "articles": [
      {
        "sequence_id": 1,
        "text": "Bonn, den 15. Mai 1961"
      },
      {
        "sequence_id": 2,
        "text": "Lieber Fritz!"
      },
      {
        "sequence_id": 3,
        "text": "Seit acht Tagen sind wir in Bonn und fühlen uns hier eigentlich recht wohl."
      },
      {
        "sequence_id": 4,
        "text": "Wir sind erst mit dem Auto nach Heidelberg gefahren und haben dort Freunde besucht und von dort habe ich Dir auch eine Ansichtskarte geschrieben."
      },
      {
        "sequence_id": 5,
        "text": "Glücklicherweise ist das Wetter jetzt sehr schön."
      },
      {
        "sequence_id": 6,
        "text": "Es hat furchtbar geregnet, als wir in Bremerhaven ankamen."
      },
      {
        "sequence_id": 7,
        "text": "Unsere Kisten, Bilder und Teppiche sind endlich eingetroffen und wir haben uns jetzt sehr gemütlich eingerichtet."
      },
      {
        "sequence_id": 8,
        "text": "Leider müssen wir in der amerikanischen Siedlung wohnen."
      },
      {
        "sequence_id": 9,
        "text": "Die Wohnungen sind sehr schön und gross, aber es ist eben 'Klein-Amerika' und nicht Deutschland."
      },
      {
        "sequence_id": 10,
        "text": "Allerdings muss ich im Büro fast nur deutsch sprechen."
      },
      {
        "sequence_id": 11,
        "text": "Ich arbeite in der Visa-Abteilung und stelle Visa aus."
      },
      {
        "sequence_id": 12,
        "text": "Für meine Frau ist es etwas schwieriger."
      },
      {
        "sequence_id": 13,
        "text": "Sie kauft natürlich in der 'Commisary' ein und spricht fast den ganzen Tag nur englisch."
      },
      {
        "sequence_id": 14,
        "text": "Die Kinder wollen wir in eine deutsche Schule schicken, damit sie gut deutsch lernen und deutsche Freunde finden."
      },
      {
        "sequence_id": 15,
        "text": "Wir wollen uns ein Theater-Abonnement nehmen und viel ins Theater und in die Oper gehen."
      },
      {
        "sequence_id": 16,
        "text": "Im Sommer wollen wir oft mit dem Auto in die Umgebung fahren."
      },
      {
        "sequence_id": 17,
        "text": "Vieles ist neu für uns; wenn wir uns etwas besser hier eingelebt haben, schreibe ich Dir ausführlicher."
      },
      {
        "sequence_id": 18,
        "text": "Ich hoffe, dass es Dir und Deiner ganzen Familie gut geht und dass Ihr uns auch bald einmal schreibt."
      },
      {
        "sequence_id": 19,
        "text": "Grüss' bitte alle herzlich von uns."
      },
      {
        "sequence_id": 20,
        "text": "Viele Grüße"
      },
      {
        "sequence_id": 21,
        "text": "Dein Bill"
      }
    ],
