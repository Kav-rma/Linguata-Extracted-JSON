  "articles": [
    {
      "sequence_id": 1,
      "text": "Wo wohnen eigentlich die Eltern von Herrn Keller?"
    },
    {
      "sequence_id": 2,
      "text": "Sie wohnen in München."
    },
    {
      "sequence_id": 3,
      "text": "Können Sie mir ihre Adresse geben?"
    },
    {
      "sequence_id": 4,
      "text": "Gern! Wollen Sie sie besuchen?"
    },
    {
      "sequence_id": 5,
      "text": "Ja."
    },
    {
      "sequence_id": 6,
      "text": "Ich muss heute nach Schwabing fahren und da will ich sie auch besuchen."
    },
    {
      "sequence_id": 7,
      "text": "Mr. Becker meets Miss Adams in a cafe."
    },
    {
      "sequence_id": 8,
      "text": "He says he hasn't seen her for a long time and asks her how she is and if she's going to stay in Munich now."
    },
    {
      "sequence_id": 9,
      "text": "She says yes, she's probably staying for four months."
    },
    {
      "sequence_id": 10,
      "text": "She likes it very much in Munich."
    },
    {
      "sequence_id": 11,
      "text": "Mr. Becker asks her if she has something planned now and Miss Adams tells him that she'd like to go to the movies."
    },
    {
      "sequence_id": 12,
      "text": "Mr. Becker asks if he may come along and Miss Adams says she'd be glad to have him."
    },
    {
      "sequence_id": 13,
      "text": "Miss Adams points to Mr. and Mrs. Jones at the movies and asks Mr. Becker if he knows them."
    },
    {
      "sequence_id": 14,
      "text": "He says he doesn't know them and asks who they are."
    },
    {
      "sequence_id": 15,
      "text": "They are Americans."
    },
    {
      "sequence_id": 16,
      "text": "Mr. Becker wonders where they live and Miss Adams tells him they live near her."
    },
    {
      "sequence_id": 17,
      "text": "Mr. Jones is a Foreign Service Officer and works at the consulate."
    },
    {
      "sequence_id": 18,
      "text": "Mr. Becker asks if the Joneses can speak German."
    },
    {
      "sequence_id": 19,
      "text": "Mr. Jones doesn't speak German very well but Mrs. Jones does."
    },
    {
      "sequence_id": 20,
      "text": "She is German."
    }
