  "articles": [
    {
      "sequence_id": 1,
      "text": "Mr. Keller and his wife wish to visit their son in America."
    },
    {
      "sequence_id": 2,
      "text": "They go to the American Consulate to apply for a visitor's visa."
    },
    {
      "sequence_id": 3,
      "text": "Vice Consul Allen in the visa section interviews them and asks for their passport, identification and where they are going."
    },
    {
      "sequence_id": 4,
      "text": "Mr. Köhler and an acquaintance, Vice Consul Jones, meet in a restaurant near the consulate."
    },
    {
      "sequence_id": 5,
      "text": "They have a beer together and Köhler offers Jones a cigar."
    },
    {
      "sequence_id": 6,
      "text": "Jones thanks him but explains he only smokes a pipe."
    },
    {
      "sequence_id": 7,
      "text": "Köhler also prefers a pipe and Jones offers him his tobacco."
    },
    {
      "sequence_id": 8,
      "text": "Jones asks Köhler what he's doing in this part of town."
    },
    {
      "sequence_id": 9,
      "text": "Köhler tells him he is planning a business trip to the United States and needs a visa."
    }
