  "articles": [
    {
      "sequence_id": 1,
      "text": "Herr Allen klingelt bei Herrn Schneider in der zweiten Etage."
    },
    {
      "sequence_id": 2,
      "text": "Er möchte sich Herrn Schneiders Schreibmaschine leihen."
    },
    {
      "sequence_id": 3,
      "text": "Er muss nämlich einige Briefe schreiben und seine Schreibmaschine ist noch unterwegs."
    },
    {
      "sequence_id": 4,
      "text": "Herr Schneider will ihm die Schreibmaschine gern leihen, aber will Herr Allen nicht für einen Augenblick hereinkommen?"
    },
    {
      "sequence_id": 5,
      "text": "Herr Schneider arbeitet auch im Konsulat und möchte wissen, in welcher Abteilung Herr Allen arbeitet."
    },
    {
      "sequence_id": 6,
      "text": "Er fragt ihn auch, woher er kommt, wo seine Heimatstadt ist, usw."
    },
    {
      "sequence_id": 7,
      "text": "Allens gefällt es in Frankfurt sehr gut, und Herrn Allen gefällt auch seine Arbeit."
    },
    {
      "sequence_id": 8,
      "text": "Dann sagt er Auf Wiedersehen; die Schreibmaschine kann er gleich mitnehmen."
    }
  ],
