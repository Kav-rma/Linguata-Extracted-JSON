      {
        "sequence_id": 1,
        "text": "Herr Wilson fährt zum Konsulat."
      },
      {
        "sequence_id": 2,
        "text": "Er will aber vorher noch im Papiergeschäft zwei Kugelschreiber, einen Radiergummi und ein Lineal für seine Kinder kaufen."
      },
      {
        "sequence_id": 3,
        "text": "Er fragt den Verkäufer, wo die Illustrierten sind."
      },
      {
        "sequence_id": 4,
        "text": "Der zeigt sie ihm und Herr Wilson kauft eine für seine Frau."
      },
      {
        "sequence_id": 5,
        "text": "Er trifft Herrn Meyer auf der Strasse."
      },
      {
        "sequence_id": 6,
        "text": "Sie kennen sich gut."
      },
      {
        "sequence_id": 7,
        "text": "Herr Meyer erzählt Herrn Wilson, dass er eine Geschäftsreise nach Amerika machen muss."
      },
      {
        "sequence_id": 8,
        "text": "Er fährt nächsten Monat nach New York."
      },
      {
        "sequence_id": 9,
        "text": "Die Herren fahren zusammen zum Konsulat."
      },
      {
        "sequence_id": 10,
        "text": "Herr Meyer will sich sein Visum dort abholen."
      },
      {
        "sequence_id": 11,
        "text": "Herr Wilson bittet ihn, seine Schwiegereltern in New York zu besuchen."
      },
      {
        "sequence_id": 12,
        "text": "Sie zeigen Herrn Meyer bestimmt gern die Stadt."
      },
      {
        "sequence_id": 13,
        "text": "Er gibt ihm die Adresse und dann verabschieden sich die Herren."
