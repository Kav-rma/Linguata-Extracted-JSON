  "articles": [
    {
      "sequence_id": 1,
      "text": "Herr Keller geht in Frau Schulzes Schreibwarengeschäft."
    },
    {
      "sequence_id": 2,
      "text": "Er will einen Füller, sechs Bleistifte und Tinte haben."
    },
    {
      "sequence_id": 3,
      "text": "Frau Schulze kennt ihn gut."
    },
    {
      "sequence_id": 4,
      "text": "Er sagt, seine Schreibmaschine ist kaputt und er muss einige Briefe mit der Hand schreiben."
    },
    {
      "sequence_id": 5,
      "text": "Herr Jones kommt herein, er möchte Briefmarken haben."
    },
    {
      "sequence_id": 6,
      "text": "Die hat Frau Schulze nicht, er muss zur Post in die Stadt fahren."
    },
    {
      "sequence_id": 7,
      "text": "Herr Keller fährt sowieso in die Stadt."
    },
    {
      "sequence_id": 8,
      "text": "Er nimmt Herrn Jones gern mit."
    }
