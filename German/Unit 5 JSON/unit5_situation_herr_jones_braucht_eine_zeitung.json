  "articles": [
    {
      "sequence_id": 1,
      "text": "Herr Jones klingelt bei seinem Bekannten, Herrn Becker."
    },
    {
      "sequence_id": 2,
      "text": "Er möchte sich eine Zeitung leihen."
    },
    {
      "sequence_id": 3,
      "text": "Herr Becker hat leider keine, er will sich gerade eine holen."
    },
    {
      "sequence_id": 4,
      "text": "Will Herr Jones mitkommen?"
    },
    {
      "sequence_id": 5,
      "text": "Unterwegs treffen sie Herrn Keller."
    },
    {
      "sequence_id": 6,
      "text": "Herr Keller zeigt ihnen einige Bücher."
    },
    {
      "sequence_id": 7,
      "text": "Eins der Bücher ist ein Roman von Cocteau."
    },
    {
      "sequence_id": 8,
      "text": "Herr Jones und Herr Becker kennen den Roman nicht."
    },
    {
      "sequence_id": 9,
      "text": "Herr Keller liest sehr viel."
    },
    {
      "sequence_id": 10,
      "text": "Er bietet Herrn Becker eins seiner Bücher an, aber Herr Becker liest nicht gern Romane."
    },
    {
      "sequence_id": 11,
      "text": "Er liest lieber Zeitungen."
    },
    {
      "sequence_id": 12,
      "text": "Herr Jones möchte sich aber gern ein Buch von Herrn Keller leihen."
    }
  ],
