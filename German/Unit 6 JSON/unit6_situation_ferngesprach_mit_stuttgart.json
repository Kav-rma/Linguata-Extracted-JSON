  "articles": [
    {
      "sequence_id": 1,
      "text": "Herr Jones wohnt in München."
    },
    {
      "sequence_id": 2,
      "text": "Er möchte am Samstag seine deutschen Bekannten in Stuttgart besuchen und ruft sie vorher an."
    },
    {
      "sequence_id": 3,
      "text": "Leider weiss er ihre Telefonnummer nicht, aber er hat die Adresse."
    },
    {
      "sequence_id": 4,
      "text": "Er wählt Null und das Fernamt meldet sich."
    },
    {
      "sequence_id": 5,
      "text": "Herr Jones sagt, er möchte mit Herrn oder Frau Walter Müller in Stuttgart, Ludwigstrasse 4 sprechen."
    },
    {
      "sequence_id": 6,
      "text": "Das Fernamt sagt ihm die Nummer und verbindet ihn."
    },
    {
      "sequence_id": 7,
      "text": "Frau Müller ist leider am Samstag nicht da."
    },
    {
      "sequence_id": 8,
      "text": "Aber am Sonntag passt es ihnen gut."
    }
