  "articles": [
    {
      "sequence_id": 1,
      "text": "Frau Schmidt will ihre Verwandten in Amerika besuchen."
    },
    {
      "sequence_id": 2,
      "text": "Sie ruft im amerikanischen Generalkonsulat in Frankfurt an."
    },
    {
      "sequence_id": 3,
      "text": "Sie möchte wissen: Kann sie bald ein Besuchsvisum bekommen?"
    },
    {
      "sequence_id": 4,
      "text": "Der amerikanische Vizekonsul sagt ihr, sie möchte am nächsten Tag zu ihm ins Büro kommen."
    },
    {
      "sequence_id": 5,
      "text": "Frau Schmidt fragt, wann es ihm passt."
    },
    {
      "sequence_id": 6,
      "text": "Er sagt, am besten zwischen zehn und elf Uhr."
    },
    {
      "sequence_id": 7,
      "text": "Sie braucht ihren Pass und ihre Ausweise."
    },
    {
      "sequence_id": 8,
      "text": "Dann kann sie das Visum beantragen."
    }
