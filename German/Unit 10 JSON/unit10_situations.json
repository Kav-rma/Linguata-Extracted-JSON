    "articles": [
      {
        "sequence_id": 1,
        "text": "Herr Becker und Herr Jones sitzen im Restaurant."
      },
      {
        "sequence_id": 2,
        "text": "Der Ober bringt ihnen die Speisekarte und sie bestellen."
      },
      {
        "sequence_id": 3,
        "text": "Die beiden Herren sprechen zusammen."
      },
      {
        "sequence_id": 4,
        "text": "Herr Becker sagt, dass seine Frau und er am zehnten August nach Bonn fahren werden."
      },
      {
        "sequence_id": 5,
        "text": "Herr Jones möchte wissen, ob sie mit dem Auto fahren und wie lange sie in Bonn bleiben wollen."
      },
      {
        "sequence_id": 6,
        "text": "Herr Becker und Herr Jones sprechen über das Essen in einigen Restaurants, was sie gern und was sie nicht gern essen."
      },
      {
        "sequence_id": 7,
        "text": "Dann bestellt Herr Becker das zweite Glas Bier."
      },
      {
        "sequence_id": 8,
        "text": "Der Ober fragt Herrn Jones, ob er ihm auch noch ein Glas Bier bringen darf."
      },
      {
        "sequence_id": 9,
        "text": "Aber Herr Jones hätte lieber eine Tasse Kaffee und dazu will er ein Stück Kuchen essen."
      },
      {
        "sequence_id": 10,
        "text": "Herr Jones fragt Herrn Becker, wann er meistens zu Mittag isst und ob er abends kalt oder warm isst."
      },
      {
        "sequence_id": 11,
        "text": "Herr Becker sagt es ihm und später fragt er Herrn Jones, wann er seine Hauptmahlzeit gewöhnlich isst."
      },
      {
        "sequence_id": 12,
        "text": "Er weiss nicht, dass man in Amerika oft mittags und abends warm isst."
      },
      {
        "sequence_id": 13,
        "text": "Herr Jones ruft den Ober, er möchte gern zahlen."
      },
      {
        "sequence_id": 14,
        "text": "Sein Essen kostet fünf Mark fünfunddreissig."
      },
      {
        "sequence_id": 15,
        "text": "Er gibt dem Ober zehn Mark und der Ober wechselt das Geld und gibt ihm vier Mark fünfundsechzig zurück."
      },
      {
        "sequence_id": 16,
        "text": "Dann bezahlt Herr Becker für sein Essen."
      }
    ],
