    "articles": [
      {
        "sequence_id": 1,
        "text": "Herr und Frau Burke kommen am 10. Juli auf dem Flughafen in Frankfurt an."
      },
      {
        "sequence_id": 2,
        "text": "Sie sind zum ersten Mal in Deutschland."
      },
      {
        "sequence_id": 3,
        "text": "Ihre Freunde holen sie ab und da es gerade Mittagszeit ist, gehen sie erst einmal in ein Restaurant."
      },
      {
        "sequence_id": 4,
        "text": "Der Ober bringt die Speisekarte und Burkes sind froh, dass ihnen ihre Freunde helfen können."
      },
      {
        "sequence_id": 5,
        "text": "Frau Burke hat zwar ein kleines Wörterbuch, aber das Lesen einer Speisekarte ist ziemlich schwierig."
      },
      {
        "sequence_id": 6,
        "text": "Das Essen schmeckt ihnen sehr gut."
      },
      {
        "sequence_id": 7,
        "text": "Sie wundern sich aber, dass der Ober ihnen kein Eiswasser bringt."
      },
      {
        "sequence_id": 8,
        "text": "Salz, Pfeffer und Senf stehen auf dem Tisch."
      },
      {
        "sequence_id": 9,
        "text": "Als Nachtisch bestellen sie sich später noch ein Stück Kuchen."
      },
      {
        "sequence_id": 10,
        "text": "Frau Wilson erzählt Burkes, dass sehr viele Deutsche nachmittags in ein Café gehen und dort Torte essen und Kaffee trinken, sofern sie es sich geldlich und zeitlich leisten können."
      },
      {
        "sequence_id": 11,
        "text": "Frau Burke fällt es auf, dass die Leute am Nebentisch nie beim Essen das Messer aus der Hand legen."
      },
      {
        "sequence_id": 12,
        "text": "Sie haben die Gabel in der linken Hand und mit dem Messer schieben sie das Gemüse, Fleisch und die Kartoffeln auf die Gabel."
      },
      {
        "sequence_id": 13,
        "text": "Sie haben immer beide Hände auf dem Tisch."
      },
      {
        "sequence_id": 14,
        "text": "Ja, andere Länder, andere Sitten!"
      }
    ],
