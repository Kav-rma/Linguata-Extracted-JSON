  "articles": [
    {
      "sequence_id": 1,
      "text": "Wissen Sie schon, dass Smiths heute umziehen?"
    },
    {
      "sequence_id": 2,
      "text": "Wohin?"
    },
    {
      "sequence_id": 3,
      "text": "Nun, ich glaube nach Chicago."
    },
    {
      "sequence_id": 4,
      "text": "Sie wollen wissen, was sie mit den Möbeln machen?"
    },
    {
      "sequence_id": 5,
      "text": "Die Herrenzimmer- und Esszimmermöbel wollen sie verkaufen, auch das neue Klavier."
    },
    {
      "sequence_id": 6,
      "text": "Sie nehmen nur die Teppiche, Bilder, Bücher und ihre Betten mit."
    },
    {
      "sequence_id": 7,
      "text": "Warum?"
    },
    {
      "sequence_id": 8,
      "text": "Ja, so ein Umzug ist doch furchtbar teuer und in Chicago können sie sich ja wieder neue Möbel kaufen."
    },
    {
      "sequence_id": 9,
      "text": "Frau Smith möchte sowieso gern ein Ecksofa im dänischen Stil haben."
    },
    {
      "sequence_id": 10,
      "text": "Sie verstehen das nicht?"
    },
    {
      "sequence_id": 11,
      "text": "Ja, ist denn das in Deutschland anders als hier?"
    },
    {
      "sequence_id": 12,
      "text": "Erzählen Sie mal."
    },
    {
      "sequence_id": 13,
      "text": "Hier ist zum Beispiel die Familie Schröder aus Hamburg."
    },
    {
      "sequence_id": 14,
      "text": "Herr Schröder arbeitet schon ein Jahr in München und nun hat er endlich eine Wohnung gefunden und seine Familie kann umziehen."
    },
    {
      "sequence_id": 15,
      "text": "Es ist zwar nur eine kleine Etagenwohnung aber er muss dafür schon 3000.-- DM Baukostenzuschuss zahlen."
    },
    {
      "sequence_id": 16,
      "text": "Es ist ja so schwer eine Wohnung zu finden."
    },
    {
      "sequence_id": 17,
      "text": "Heute kommt nun also der Möbelwagen."
    },
    {
      "sequence_id": 18,
      "text": "Alle Möbel kommen mit, sogar der alte Schrank und der kleine Schreibtisch von Onkel Fritz, der auf den Boden stand."
    },
    {
      "sequence_id": 19,
      "text": "Das sind alte Familienstücke und daran hängt man doch!"
    },
    {
      "sequence_id": 20,
      "text": "Die neue Wohnung ist klein, aber irgendwo wird man schon einen Platz dafür finden."
    },
    {
      "sequence_id": 21,
      "text": "Man kann die Sachen ja zuerst auch auf den Boden stellen."
    },
    {
      "sequence_id": 22,
      "text": "Und vielleicht geht der Traum vom 'Eigenheim' doch mal in Erfüllung."
    }
  ],
