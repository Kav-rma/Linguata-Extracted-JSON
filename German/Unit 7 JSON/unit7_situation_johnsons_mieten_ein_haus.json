  "articles": [
    {
      "sequence_id": 1,
      "text": "Herr und Frau Johnson sehen sich im Vorort von Stuttgart ein Haus an."
    },
    {
      "sequence_id": 2,
      "text": "Es gehört Herrn Meyer, und der möchte es vermieten."
    },
    {
      "sequence_id": 3,
      "text": "Johnsons brauchen ein grosses Haus."
    },
    {
      "sequence_id": 4,
      "text": "Sie haben vier kleine Kinder."
    },
    {
      "sequence_id": 5,
      "text": "Herr Meyer zeigt ihnen die Zimmer."
    },
    {
      "sequence_id": 6,
      "text": "Das Haus gefällt Johnsons sehr gut."
    },
    {
      "sequence_id": 7,
      "text": "Die Küche ist sehr gross, hat aber leider keinen Kühlschrank und nur einen alten Herd."
    },
    {
      "sequence_id": 8,
      "text": "Herr Meyer will aber einen neuen Kühlschrank in die Küche stellen."
    },
    {
      "sequence_id": 9,
      "text": "Dann zeigt er den Garten hinter dem Haus."
    },
    {
      "sequence_id": 10,
      "text": "Herr Johnson möchte wissen, wie hoch die Miete ist."
    },
    {
      "sequence_id": 11,
      "text": "Herr Meyer sagt 400.-- DM."
    },
    {
      "sequence_id": 12,
      "text": "Johnsons mieten das Haus."
    }
  ],
