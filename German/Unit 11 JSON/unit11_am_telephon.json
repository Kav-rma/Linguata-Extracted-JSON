  "articles": [
    {
      "sequence_id": 1,
      "text": "Gerhard Becker ruft seinen Freund, Klaus König, an."
    },
    {
      "sequence_id": 2,
      "text": "Er fragt ihn, ob er mit ihm am Wochenende nach München fahren will."
    },
    {
      "sequence_id": 3,
      "text": "Klaus hat leider keine Zeit, er muss am Sonnabend zum Zahnarzt und Sonntag früh erwartet er seine Eltern."
    },
    {
      "sequence_id": 4,
      "text": "Gerhard fragt, wie lange seine Eltern bleiben wollen und was sie vorhaben."
    },
    {
      "sequence_id": 5,
      "text": "Klaus sagt, dass seine Eltern nur zwei bis drei Tage bleiben werden und dass er ihnen die Stadt zeigen will."
    },
    {
      "sequence_id": 6,
      "text": "Am Sonntag abend will er mit ihnen ins Theater gehen."
    },
    {
      "sequence_id": 7,
      "text": "Dann fragt Gerhard seinen Freund, ob er jetzt mit ihm zu Mittag essen will."
    },
    {
      "sequence_id": 8,
      "text": "Klaus hat Zeit und beide wollen um 12:30 Uhr im Restaurant am Markt sein."
    }
