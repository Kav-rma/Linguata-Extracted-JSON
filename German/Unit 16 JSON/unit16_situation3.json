    "articles": [
      {
        "sequence_id": 1,
        "text": "Sie machen einen Ausflug mit einem Dampfer von Norderney nach Helgoland."
      },
      {
        "sequence_id": 2,
        "text": "Sie unterhalten sich mit einem Herrn, der neben Ihnen sitzt."
      },
      {
        "sequence_id": 3,
        "text": "Sie sagen ihm, dass die Fischerei Sie interessiert und dass Sie schon viel über Helgoland gelesen haben."
      },
      {
        "sequence_id": 4,
        "text": "Der Herr stellt sich Ihnen vor und erzählt Ihnen, dass er vor kurzem in Amerika gewesen ist."
      },
      {
        "sequence_id": 5,
        "text": "Er war auch in Washington und hat dort eine Segelregatta auf dem Potomac gesehen."
      },
      {
        "sequence_id": 6,
        "text": "Sie fragen ihn, wo man in Deutschland eine Regatta sehen kann und er erzählt Ihnen, dass man dazu am besten an die Nord- oder Ostsee fährt."
      },
      {
        "sequence_id": 7,
        "text": "Dann fragen Sie den Herrn, ob Sie wissen, dass man in Helgoland alles zollfrei bekommen kann."
      },
      {
        "sequence_id": 8,
        "text": "Davon haben Sie schon gehört und Sie planen, sich dort einige Sachen zu besorgen."
      }
