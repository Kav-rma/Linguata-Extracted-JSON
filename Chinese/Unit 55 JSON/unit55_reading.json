  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào Guǎngzhōu Jiāoyìhuì qù cānguān. Yíge péngyou gěi wǒ jièshào: zhèli bú dàn yǒu chūkǒude mǎimai, yě yǒu hěn duō rén zài zhèr tán jìnkǒu màoyì."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: zhèi jǐnián, Zhōngguo zài jǐge dìfang chénglìle jīngjì tèqū, jìnchūkǒu màoyì hé jiāgōng gōngyè yuè gǎo yuè duō, suǒyǐ jiāoyìhuì yě yuè lái yuè rènao le."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ wèn: jīngjì tèqūlǐ gōngrende gōngzī bǐjiào gāo, huì bu huì chūxiàn yíge xīnde jiējí? Tā shuō: méiyou nàme yánzhòng, yīnwei 'duō láo duō dé' shi shèhuìzhǔyìde zhèngcè."
    },
    {
      "sequence_id": 4,
      "text": "Tā yòu shuō: yǒule Zhōng-Měi hǎiyùn tiáoyuē yǐhòu, yánhǎi yídàide dà hǎigǎng dōu gèng fánróng le, hěn duō wàiguó shāngren dōu lái zhèr zuò mǎimai."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde, yíge guójiā zhīsuǒyǐ néng fāzhǎn jīngjì, bú dàn yào duì wàiguó kāifàng, gēn biéde guójiā hézuò, gèng yào yǒu zìjǐ qīngchude zhèngcè hé fāngxiàng."
    }
  ],
