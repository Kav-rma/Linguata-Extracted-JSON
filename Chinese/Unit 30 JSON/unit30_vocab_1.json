  "questions_and_answers": [
    {
      "sequence_id": 1,
      "question_text": "Lǎo Sòng, zěnmeyàng? Máng ne?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Sòng, how are things going? Are you busy?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 2,
      "question_text": "Bù zěnme máng. Nǐ yǒu shì ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Not especially busy. Can I do something for you?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 3,
      "question_text": "Wǒ Sìyuè Shísìhào yào dào Guǎngzhōu qù. Qǐng ni gěi wo dìng yìzhāng fēijī piào.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I'm going to Guǎngzhōu on April 14. Please reserve a plane ticket for me.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 4,
      "question_text": "Hǎo.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Sure.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 5,
      "question_text": "Piào dìnghǎo le.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "The ticket has been reserved.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 6,
      "question_text": "Něibān fēijī? Jǐdiǎn zhōng qǐfēi?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Which flight? What time does it take off?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 7,
      "question_text": "Jiǔdiǎn shíwǔfēn qǐfēi.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It takes off at 9:15.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 8,
      "question_text": "Zhèibān fēijī zhí fēi Guǎngzhōu ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Does this flight go directly to Guǎngzhōu?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 9,
      "question_text": "Shì, zhí fēi Guǎngzhōu.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Yes, it flies directly to Guǎngzhōu.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 10,
      "question_text": "Cóng Sānlǐtún dào fēijīchǎng yào duōshao shíjiān?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "How much time does it take to go from Sānlǐtún to the airport?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 11,
      "question_text": "Yào sìshifēn zhōng.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It takes forty minutes.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Rúguǒ wǒ bādiǎn zhōng líkāi jiā, láidejí ba?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "If I leave home at eight o'clock, I can make it in time. Right?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 13,
      "question_text": "Láidejí.",
