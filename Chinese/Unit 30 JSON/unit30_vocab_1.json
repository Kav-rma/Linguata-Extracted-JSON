      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Yes.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 14,
      "question_text": "Qǐng ni míngtian zǎoshang pài ge chē lái jiē wo.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Please send a car to pick me up tomorrow morning.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 15,
      "question_text": "Hǎo. Wǒ míngtian bādiǎn zhōng pài chē sòng ni dào fēijīchǎng qu.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Okay. I'll send a car at eight o'clock tomorrow to take you to the airport.",
          "is_correct": true
        }
      ]
    },
