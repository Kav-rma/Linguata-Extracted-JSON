  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào Lǎo Sòngde bàngōngshì. Wǒ shuō: Lǎo Sòng, zěnmeyang? Máng ne? Tā shuō: bù zěnme máng, nǐ yǒu shì ma?"
    },
    {
      "sequence_id": 2,
      "text": "Wǒ shuō: wǒ Sìyuè shísìhào yào dào Guǎngzhōu qù chū chāi kāi huì, qǐng nǐ gěi wǒ dìng yìzhāng fēijī piào."
    },
    {
      "sequence_id": 3,
      "text": "Guòle yìhuǐr, tā shuō: piào dìnghǎo le. Wǒ wèn: nǎibān fēijī? Jǐdiǎn zhōng qǐfēi? Tā shuō: jiǔdiǎn shíwǔfēn qǐfēi."
    },
    {
      "sequence_id": 4,
      "text": "Tā tíxǐng wǒ: nǐ zuìhǎo zǎo yìdiǎn dào jīchǎng, yàoburán kěnéng gǎnbushang fēijī."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde Lǎo Sòng zuò shì hěn kuài, yě hěn xiǎode zhōu dào, suǒyǐ wǒ měicì chū chāi dōu qǐng tā bāng máng."
    }
  ],
