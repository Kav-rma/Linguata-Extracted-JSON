  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào Shǒudū Gāngtiě Gōngsī qù cānguān. Dǎoyóu shuō: zhèige gōngsī bǐ yíge xiǎo chéng hái dà, yǒu hǎojǐwàn zhígōng hé jiāshǔ."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: gōngsī bùdàn yǒu shítáng, yòu'éryuán, hái yǒu yèdàxué, ràng zhígōng zài yèyú shíjiān xuéxí jìshu, suǒyǐ dàjiāde shuǐpíng dōu tígāode hěn kuài."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ wèn: zhèyàng dàde gāngtiě gōngsī, huì bu huì yǒu wūrǎnde wèntí? Dǎoyóu shuō: huì, zhòng gōngyè duì shǒudū lái shuō quèshí bú tài héshì, zhèngfǔ zhèngzài xiǎng bànfǎ."
    },
    {
      "sequence_id": 4,
      "text": "Tā yòu shuō: zhèngfǔ juédìng bǎ Běijīng jiànshèchéng yíge yǒu wénhuà, shēnghuó fāngbian, yòu fēicháng gānjìngde chéngshì."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde, yíge guójiā zài fāzhǎn gōngyède shíhou, bù néng zhǐ kàn chǎnliàng, gèng yào zhùyì huánjìng, zhèyàng cái néng ràng rénmínde shēnghuó zhēnzhèng hǎoqǐlai."
    }
  ],
