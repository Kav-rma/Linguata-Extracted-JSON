      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Yes. Is this Miss White?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 4,
      "question_text": "Shì. Zhāng Xiānsheng, wǒ yǒu yíjiàn shì xiǎng gēn nín dǎting dǎting.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Yes. Mr. Zhāng, I have something I would like to ask you about.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 5,
      "question_text": "Shénme shì?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "What is it?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 6,
      "question_text": "Tīngshuō nín nàbian xīn láile yíwèi Fāng Xiānsheng, shi gāng pàilaide; tāde míngzi wǒ wàngji le.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I have heard that you recently had a Mr. Fāng join you, who has just been assigned to your office. I have forgotten his given name.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 7,
      "question_text": "Bú cuò, Fāng Démíng shi shàngge lǐbài pài dào wǒmen zhèli láide.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "That's right. Fāng Démíng was sent over here last week.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 8,
      "question_text": "Zěnme? Nǐ rènshi ta ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Why? Do you know him?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 9,
      "question_text": "Bú rènshi.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I don't know him.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 10,
      "question_text": "Búguò tīngshuō tā yě shi Jiāzhōu Dàxué bìyède, suǒyǐ xiǎng qǐng ni gěi wo jièshao jièshao.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "However, I have heard that he also graduated from the University of California, so I wanted to ask you to introduce me to him.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 11,
      "question_text": "Méi wèntí. Wǒ kànkan... hǎo, wǒmen xiànzài dōu yǒu gōngfu.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "No problem. I'll take a look.... Okay, we are both free now.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Nǐ xiànzài néng lái ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Can you come now?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 13,
      "question_text": "Xíng.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "That will be fine.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 14,
      "question_text": "Wǒ mǎshang dào nín bàngōngshì lái.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I'll come to your office right away.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 15,
      "question_text": "Chàbuduō bànge zhōngtóu jiù dào.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I'll be there in about half an hour.",
          "is_correct": true
        }
      ]
    },
