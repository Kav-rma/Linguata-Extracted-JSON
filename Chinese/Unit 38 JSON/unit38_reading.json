  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ gěi Zhāng Xiānsheng dǎ diànhuà. Wǒ shuō: Zhāng Xiānsheng, wǒ yǒu yíjiàn shì xiǎng gēn nín dǎting dǎting."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: shénme shì? Wǒ shuō: tīngshuō nín nàbian xīn láile yíwèi Fāng Xiānsheng, shi gāng pàilaide, kěshi tāde míngzi wǒ wàngjì le."
    },
    {
      "sequence_id": 3,
      "text": "Zhāng Xiānsheng shuō: bú cuò, Fāng Démíng shi shàngge lǐbài pài dào wǒmen zhèli láide. Zěnme, nǐ rènshi tā ma?"
    },
    {
      "sequence_id": 4,
      "text": "Wǒ shuō: wǒ bú tài rènshi tā, kěshi wǒ jìde wǒmen céngqián zài yíge huìshang jiànguo yícì."
    },
    {
      "sequence_id": 5,
      "text": "Zhāng Xiānsheng shuō: nà hǎo, děng tā huílaide shíhou, wǒ gàosong tā nǐ zhǎoguo tā."
    }
  ],
