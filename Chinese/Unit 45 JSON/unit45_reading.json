  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ duì péngyou shuō: nǐ yàoshi xiǎng tīng gùshide huà, wǒ gěi nǐ jiǎng yíge ya! Tā shuō: suàn le, wǒmen xià qí ba!"
    },
    {
      "sequence_id": 2,
      "text": "Hòulái wǒmen tánqǐ zhèngzhì. Tā shuō: tīngshuō jiěfàng yǐhòu, Gòngchǎndǎng zuòle xiē hǎo shì."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ shuō: ǹg, yǒu xiē zhèngcè bú cuò, yǒu xiē bú tài hǎo."
    },
    {
      "sequence_id": 4,
      "text": "Tā shuō: yàoshi cóng shēngchǎnshang kàn de huà, zhè jǐnián nóngcūnde qíngkuàng quèshí hǎo le bù shǎo."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde, yíge guójiāde zhèngcè zǒngshi zài biàn, wǒmen yīnggāi duō liǎojiě, ránhòu zài shuō tā hǎo háishi bù hǎo."
    }
