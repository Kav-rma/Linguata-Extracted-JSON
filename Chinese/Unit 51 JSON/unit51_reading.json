  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào Běijīng cānguān. Dǎoyóu shuō: Běijīng shi Zhōngguo hěn duōge cháodàide shǒudū, yǒu hěn chángde lìshǐ, yě yǒu fēngfùde wénhuà."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: zhèli yǒu hěn duō gǔdàide jiànzhù, xiàng Gùgōng, Chángchéng zhèixiē dìfang, dōu shi shìjiè yǒu míngde, měinián xīyǐn hěn duō yóukè."
    },
    {
      "sequence_id": 3,
      "text": "Yǒu yíge yóukè wèn: zhèixiē gǔ jiànzhù zěnme bǎohùde zhème hǎo? Dǎoyóu shuō: zhèngfǔ fēicháng zhòngshì, huāle bù shǎo qián hé rénlì lái bǎohù tāmen."
    },
    {
      "sequence_id": 4,
      "text": "Tā yòu shuō: yīnwei zhèixiē dōngxi bú dàn shi Zhōngguóde, yě shi quán shìjièrén dōu yīnggāi bǎohùde wénhuà, suǒyǐ wǒmen gèng bù néng bù xiǎoxīn."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde, yíge guójiā zhīsuǒyǐ ràng rén zūnjìng, bú zhǐ yīnwei tā jīngjì fādá, gèng yīnwei tā zhīdao zěnyàng bǎohù zìjǐde lìshǐ hé wénhuà."
    }
  ],
