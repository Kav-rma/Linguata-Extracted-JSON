      "type": "short_answer",
      "answers": [
        {
          "answer_text": "When you have gotten off the elevator, go to the right, and that's the restaurant.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 5,
      "question_text": "Qǐngwèn, nǐmen zhèli yǒu meiyou lǐfàde dìfang?",
