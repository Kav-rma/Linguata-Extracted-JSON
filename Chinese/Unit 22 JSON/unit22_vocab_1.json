      "type": "short_answer",
      "answers": [
        {
          "answer_text": "How do I get there (go)?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Wàng hòu yìzhí zǒu. Shàng lóu, yòubian jiù shi mài dìtúde.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Go straight to the back. Go upstairs, and the map department is (just) on the right.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 13,
      "question_text": "Wǒ xiān wàng hòu yìzhí zǒu, shàng lóu, zuǒbian jiù shi, shi bu shi?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "First, I go straight to the back. Then, I go upstairs. And the map department is on the left. Is that it?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 14,
      "question_text": "Bù shi. Yòubian jiù shi mài dìtúde.",
