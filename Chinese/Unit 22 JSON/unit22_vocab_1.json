      "type": "short_answer",
      "answers": [
        {
          "answer_text": "May I ask, is there a place to get a haircut here?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 6,
      "question_text": "Yǒu. Cóng zhèli wàng zuǒ zǒu. Xià lóu, jiù kànjian le.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Yes. From here you go to the left. Go downstairs, and then you'll see it.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 7,
      "question_text": "Wǒ xiān cóng zhèli wàng zuǒ zǒu. Ránhòu xià lóutī jiù kànjian le, shi bu shi?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "From here I first go to the left. After that, when I have gone downstairs, I'll see it. Is that it?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 8,
      "question_text": "Shì.",
