    {
      "sequence_id": 1,
      "question_text": "Qǐngwèn cāntīng zài jǐlóu?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "May I ask, on what floor is the dining room?",
          "is_correct": true
