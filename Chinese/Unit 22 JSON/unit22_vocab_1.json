        {
          "answer_text": "It's on the second floor.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 3,
      "question_text": "Ou, wǒ zuò diàntī dào èrlóu. Xiàle diàntī wàng nǎbian zǒu?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Oh, I take the elevator to the second floor. When I have gotten off the elevator, which way do I go?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 4,
      "question_text": "Xiàle diàntī, wàng yòu zǒu, jiù shi cāntīng.",
