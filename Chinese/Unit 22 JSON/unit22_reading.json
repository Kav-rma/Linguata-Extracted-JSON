  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ zài yíge dà shāngdiànli, xiǎng lǐfà, kěshi bù zhīdao wǎng nǎbian zǒu."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ wèn: nǐmen zhèli yǒu méiyou lǐfàde dìfang? Yǒu rén shuō: cóng zhèli wǎng zuǒ zǒu, xià lóu jiù kànjian le."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ hái xiǎng mǎi yìzhāng dìtú. Dìtú zài èr lóu, wǒ děi shàng lóu, dào yòubian jiù shi mài dìtúde."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ wèn yíge rén: xǐshǒujiān zài shénme dìfang? Tā shuō: wǎng lǐ zǒu, zài yòubian."
    },
    {
      "sequence_id": 5,
      "text": "Kànjian dìyīge lùkǒu, wǎng zuǒ guǎi, yìzhí zǒu jiù dào le."
    }
