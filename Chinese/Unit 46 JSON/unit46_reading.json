  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ péngyou wèn wǒ: nǐ juéde zuìjìn shèhuìshang āndìng yìdiǎnr ma? Wǒ shuō: dāngrán, yǒule xīn fǎlǜ, fàn zuìde rén shǎoduō le."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: běnlái shèhuì luànde hěn, lián zǒu lù dōu bù ānquán; xiànzài yǒule fǎ, dàjiā dōu bù néng bù zhùyì zìjǐde zérèn le."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ shuō: wǒ juéde zhè hé jiàoyu yě yǒu guānxi. Zhǐ yào jiàoyu gǎode hǎo, rénde guānniàn jiù huì mànmàn jìnbù."
    },
    {
      "sequence_id": 4,
      "text": "Tā shuō: nǐ shuōde duì. Yǒu rén yǐwéi zhǐ kào fǎlǜ jiù xíng, qíshí jiàoyu gèng zhòngyào."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ xiǎng kànkan jīntiān bàoshang yǒu shénme, tā jiù ná le yífèn Huáshèngdùn Yóubào gěi wǒ, ràng wǒ zìjǐ zhǎozhǎo kàn."
    }
