    },
    {
      "sequence_id": 9,
      "question_text": "Nǐ jìhua zài Nánjīng zhù jǐtiān?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "How many days do you plan to stay in Nánjīng?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 10,
      "question_text": "Zhèi shi wǒ dìyīcì dào Nánjīng qù. Yǐqián méi qùguo. Nǐ shuō liǎngtiān gòu bu gòu?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "This will be the first time I have gone to Nánjīng. I haven't gone there before. Would you say two days are enough?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 11,
      "question_text": "Liǎngtiān gòu le.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Two days are enough.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Měitian yǒu jǐtàng chē?",
