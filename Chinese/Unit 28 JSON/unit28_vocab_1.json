      "sequence_id": 1,
      "question_text": "Wǒ yě xiǎng dào Nánjīng qù kànkan.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I would also like to go to Nánjīng to look around.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 2,
      "question_text": "Nǐ jìhua něitian qù?",
      "has_answer": true,
