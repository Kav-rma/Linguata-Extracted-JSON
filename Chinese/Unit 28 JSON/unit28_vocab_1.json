    },
    {
      "sequence_id": 5,
      "question_text": "Yǒu liǎngbǎiwǔshiduō gōnglǐ.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It's over 250 kilometers.",
