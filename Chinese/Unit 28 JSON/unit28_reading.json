  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ jìhua dào Nánjīng qù kànkan. Wǒ péngyou wèn wǒ néitian qù, wǒ shuō míngtian huòshi hòutian dōu kěyi."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ bù zhīdao Shànghǎi lí Nánjīng yǒu duō yuǎn, suǒyǐ wǒ wèn le yíge rén."
    },
    {
      "sequence_id": 3,
      "text": "Tā shuō: Shànghǎi lí Nánjīng yǒu liǎngbǎi wǔshíduō gōnglǐ, bù suàn tài yuǎn."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ yòu wèn: zuò huǒchē yào zǒu duōshǎo shíhou? Tā shuō: dàgài yào zǒu sìge bàn xiǎoshí."
    },
    {
      "sequence_id": 5,
      "text": "Yīnwei zuò huǒchē zhǐ yào sìge bàn xiǎoshí, bǐ zuò gōnglùjū fāngbian de duō, suǒyǐ wǒ juédìng zuò huǒchē qù."
    }
  ],
