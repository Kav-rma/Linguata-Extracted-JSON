  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ jiào Wáng Dànián, wǒ shi Zhōngguo rén. Wǒ àiren xiànzài zài Xiānggǎng, tā zhǐ zhù liǎngtian jiù zǒu."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ xiǎng zài Táiwān zhù jiǔ yìdiǎn. Wǒ xiǎng zhù bāge yuè, kěshi wǒ péngyou zhǐ xiǎng zhù liǎngge xīngqī."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ láile sāntian le. Wǒ àiren zài Xiānggǎng zhùle liǎngtian, xiànzài tā yě dào le."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ céngqián méi láiguo Táiwān, zhè shi dìyīcì. Wǒ péngyou céngqián láiguo, tā shuō Táiwān hěn hǎo."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ xiǎng tā míngtian bù zǒu, tā hái xiǎng zài zhèli zhù jǐtian."
    }
  ],
