  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào péngyou jiā qù. Wǒ shuō: nǐ bàba zhème zǎo jiù qǐlai le. Tā shuō: tā niánjì dà le, měitian shuì de zǎo, qǐ de yě zǎo."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ wèn: nǐ bàba jīnnián duō dà niánjì le? Tā shuō: tā niánjì bù xiǎo le, kěshi shēntǐ hái hěn hǎo."
    },
    {
      "sequence_id": 3,
      "text": "Wǒmen shuō huà de shíhou, tā bàba zhèngzài yuànzili kàn bào ne."
    },
    {
      "sequence_id": 4,
      "text": "Guòle yìhuǐr, tā bàba shuō: wǒ niánjì dà le, wǎnshang shuì de zǎo, suǒyǐ báitian jīngshén hái bú cuò."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde, suīrán tā niánjì dà le, kěshi tā duì shénme shì dōu hěn rèxīn, zhè zhēn ràng rén pèifú."
    }
  ],
