  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ gěi Zhū Kēzhǎng dǎ diànhuà. Wǒ shuō: wéi, nín shi Zhū Kēzhǎng ma? Tā shuō: shì, nín shi něiwèi?"
    },
    {
      "sequence_id": 2,
      "text": "Wǒ shuō: wǒ shi Wēilián Mǎdīng. Tā shuō: ō, Mǎdīng Xiānsheng, hǎo jiǔ bú jiàn."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ shuō: wǒ yǒu diǎnr shì xiǎng gēn nín dāngmiàn tántan, bù zhīdao nín yǒu gōngfu méiyou."
    },
    {
      "sequence_id": 4,
      "text": "Tā shuō: yǒu gōngfu. Wǒ wèn: shénme shíhou duì nín héshì? Tā shuō: jīntian, míngtian dōu kěyi."
    },
    {
      "sequence_id": 5,
      "text": "Yīnwei zhèijiàn shì bǐjiào zhòngyào, dǎ diànhuà shuōbuqīngchu, suǒyǐ wǒ xiǎng dāngmiàn gēn tā tán."
    }
  ],
