  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào yíge rénmín gōngshè qù cānguān. Wǒ wèn: nǐmen zhèige gōngshè jiào shénme? Dānzishang yǒu méiyou xiězhe? Nà rén shuō: xiězhe ne, jiào Sìjìqīng."
    },
    {
      "sequence_id": 2,
      "text": "Zhèige gōngshède zhǔyào gōngzuò shi zhòng dì. Tāmen zǔzhīde hěn hǎo, měige shēngchǎnduì dōu yǒu zìjǐde zérèn."
    },
    {
      "sequence_id": 3,
      "text": "Tāmen hái qǐngle jǐge zhuānjiā lái bāng máng, suǒyǐ shēngchǎnde bànfǎ yuè lái yuè xiānjìn le."
    },
    {
      "sequence_id": 4,
      "text": "Yǒu yíge lǎo shèyuán gēn wǒ shuō: yǐqián zhòng dì hěn xīnkǔ, xiànzài yǒule jīqì, jiù bǐ yǐqián hǎoduō le."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde, zhèige gōngshè zhīsuǒyǐ gǎode hǎo, shi yīnwei tāmen zǔzhīde hǎo, yòu kěn xuéxí xiānjìnde jìshu."
    }
  ],
