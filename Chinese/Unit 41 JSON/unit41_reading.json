  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ péngyou shuō: zhèiběn Fǎwén zhōukān xiāngdāng bú cuò! Nǐ xiànzài duì Fǎwén hěn yǒu yánjiū le, néng kàn Fǎwén zázhì le!"
    },
    {
      "sequence_id": 2,
      "text": "Wǒ wèn tā: nánnǚ píngděng shì bu shi Zhōngguo rénde kànfǎ? Tā shuō: shì, kěshi nà shi Zhōngguo rénde xīn guānniàn, bú shi lǎo guānniàn."
    },
    {
      "sequence_id": 3,
      "text": "Tā shuō: yǐqián zài Zhōngguo, nánnǚ bù píngděng, xiànzài bù tóng le."
    },
    {
      "sequence_id": 4,
      "text": "Tā yòu shuō: Měiguo rén gēn Zhōngguo rén duì nánnǚ píngděngde guānniàn bú tài yíyàng, yǒude dìfang xiāngtóng, yǒude dìfang bù tóng."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde, yíge shèhuìde guānniàn zǒngshi zài biàn, jiù guānniàn mànmàn méiyou le, xīn guānniàn mànmàn duō qǐlai."
    }
