  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào yíge shǎoshù mínzú zìzhìqū qù cānguān. Dǎoyóu shuō: Zhōngguo yígòng yǒu wǔshíduōge mínzú, měige mínzú dōu yǒu zìjǐde yǔyán hé fēngsú xíguàn."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: zhèli zhǔyào shi yíge shǎoshù mínzú zhùde dìfang, tāmende yīfu, yīnyuè hé chīde dōngxi dōu gēn Hànzú bù yíyàng, fēicháng yǒu tèsè."
    },
    {
      "sequence_id": 3,
      "text": "Yǒu yíge yóukè wèn: zhèli hé chénglǐ liánxì fāngbian ma? Dǎoyóu shuō: yǐqián bù fāngbian, xiànzài xiūle gōnglù, jiù hǎoduō le."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ fāxiàn zhèlide rén duì kèren tèbié rèqíng, tāmen ná chū zuì hǎode dōngxi lái zhāodài wǒmen, ràng wǒmen fēicháng gǎndòng."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ xiǎng, yíge guójiā zhīsuǒyǐ yǒu yìsi, zhèng shi yīnwei tā yǒu zhème duō bùtóngde mínzú hé fēngsú, dàjiā yìqǐ shēnghuó, hùxiāng xuéxí."
    }
  ],
