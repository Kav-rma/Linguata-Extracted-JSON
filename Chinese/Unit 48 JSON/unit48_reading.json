  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào yíge dìfang cānguān. Wǒ wèn: wǒmen zěnme chēnghu nín hǎo ne? Nà rén shuō: lái zhèli fǎngwènde rén dōu jiào wǒ Lǎo Wáng."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ běnlái yǐwéi Lǎo Wáng zhǐ shi yíge pǔtōng gōngzuò rényuán, hòulái cái zhīdao tā shi yíge yǒu míngde xuézhě, zhǔyào yánjiū yǔyánxué."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ wèn tā: zhèicì cānguān, nín kàn zěnme ānpái bǐjiào hǎo? Tā shuō: wǒ xiǎng zuìhǎo děng wǒ hé Shànghǎi fāngmiàn liánxì yíxià zài shuō."
    },
    {
      "sequence_id": 4,
      "text": "Tā yòu shuō: yīnwei zhèli yǔyán hěn duō, bùtóng mínzú shuō bùtóngde huà, suǒyǐ ānpái qǐlai bǐjiào máfan."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde Lǎo Wáng zhèige rén bùdàn xuéwèn hǎo, érqiě duì rén hěn rèxīn, ràng rén fēicháng pèifú."
    }
  ],
