  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ shi Léidēng Dàshǐde mìshū. Wǒ dǎ diànhuà dào Lǐbīnsī, shuō: dàshǐ jiēdào nǐmende qǐngtiě le."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ shuō: hěn kěxī, yīnwei tā yǒu shì, Bāyuè jiǔhào bù néng lái, qǐng nǐ zhuǎngào Qiáo Bùzhǎng, hěn bàoqiàn."
    },
    {
      "sequence_id": 3,
      "text": "Duìfāngde rén shuō: hěn yíhàn, Léidēng Dàshǐ bù néng lái. Wǒ tì nǐ zhuǎngào yíxià."
    },
    {
      "sequence_id": 4,
      "text": "Guòle jǐtian, wǒ yǒu yíge tóngxué shuō: wǒmen jǐge tóngxué Xīngqīliù jìhua dào Chángchéng qù wánr, nǐ néng bu néng yìqǐ qù?"
    },
    {
      "sequence_id": 5,
      "text": "Wǒ shuō: néng, wǒ hěn xiǎng qù. Suīrán Chángchéng lí zhèli bù jìn, kěshi zuò chē qù yě hěn fāngbian."
    }
  ],
