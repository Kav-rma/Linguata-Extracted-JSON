  "questions_and_answers": [
    {
      "sequence_id": 1,
      "question_text": "Wèi, zhèi shi Lǐbīnsī.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Hello. This is the Protocol Department.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 2,
      "question_text": "Wèi, wǒ shi Láidēng Dàshǐde mìshū.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Hello. I am Ambassador Leyden's secretary.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 3,
      "question_text": "Dàshǐ jiēzháo nǐmende qǐngtiě le.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "The ambassador received your invitation.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 4,
      "question_text": "Hěn kěxī, yīnwei tā yǒu shì, Bāyuè jiǔhào bù néng lái.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Unfortunately, because he has a previous engagement, he cannot come on August 9.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 5,
      "question_text": "Qǐng ni zhuǎngào Qiáo Bùzhǎng.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Please inform Minister Qiáo.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 6,
      "question_text": "Hěn bàoqiàn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I'm very sorry.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 7,
      "question_text": "Hěn yíhàn, Láidēng Dàshǐ bù néng lái.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "We very much regret that Ambassador Leyden cannot come.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 8,
      "question_text": "Wǒ tì ni zhuǎngào yíxià.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I will pass on the message for you.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 9,
      "question_text": "Mǎ Mínglǐ, wǒmen yǒu jǐge tóngxué Xīngqīliù jìhua dào Chángchéng qù wánr.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Mǎ Mínglǐ, a few of us students are planning to go to the Great Wall Saturday for an outing.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 10,
      "question_text": "Nǐmen néng bu néng yìqǐ qù?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Can you go with us?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 11,
      "question_text": "Zhēn bù qiǎo.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "We really couldn't make that.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Nèitian wǒmen yǒu shì, méi bànfǎ qù.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "We have a previous engagement that day; we have no way of going.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 13,
      "question_text": "Xīwàng yǐhòu zài zhǎo jīhui jùyijù ba.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I hope that later we will find another opportunity to get together.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 14,
      "question_text": "Hǎo a.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Okay.",
          "is_correct": true
        }
      ]
    },
