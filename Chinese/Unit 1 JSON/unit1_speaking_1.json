  "questions_and_answers": [],
  "articles": [
    {
      "sequence_id": 1,
      "text": "WÁNG DÀNIÁN: Nǐ shi shéi?"
    },
    {
      "sequence_id": 2,
      "text": "WÁNG DÀNIÁN: Who are you?"
    },
    {
      "sequence_id": 3,
      "text": "HÚ MĚILÍNG: Wǒ shi Hú Měilíng. Nǐ xìng shénme?"
    },
    {
      "sequence_id": 4,
      "text": "HÚ MĚILÍNG: I am Hú Měilíng. What is your surname?"
    },
    {
      "sequence_id": 5,
      "text": "WÁNG DÀNIÁN: Wǒ xìng Wáng. Wǒ shi Wáng Dànián."
    },
    {
      "sequence_id": 6,
      "text": "WÁNG DÀNIÁN: My surname is Wáng. I am Wáng Dànián."
    },
    {
      "sequence_id": 7,
      "text": "HÚ MĚILÍNG: Wáng Xiānsheng, tā shi shéi?"
    },
    {
      "sequence_id": 8,
      "text": "HÚ MĚILÍNG: Mr. Wáng, who is he?"
    },
    {
      "sequence_id": 9,
      "text": "WÁNG DÀNIÁN: Tā shi Mǎ Mínglǐ Xiānsheng."
    },
    {
      "sequence_id": 10,
      "text": "WÁNG DÀNIÁN: He is Mr. Mǎ Mínglǐ."
    },
    {
      "sequence_id": 11,
      "text": "HÚ MĚILÍNG: Tā shi shéi?"
    },
    {
      "sequence_id": 12,
      "text": "HÚ MĚILÍNG: Who is she?"
    },
    {
      "sequence_id": 13,
      "text": "WÁNG DÀNIÁN: Tā shi Mǎ Tàitai."
    },
    {
      "sequence_id": 14,
      "text": "WÁNG DÀNIÁN: She is Mrs. Mǎ."
    },
    {
      "sequence_id": 15,
      "text": "HÚ MĚILÍNG: Xièxie, Wáng Xiānsheng."
    },
    {
      "sequence_id": 16,
      "text": "HÚ MĚILÍNG: Thank you, Mr. Wáng."
    }
  ],
