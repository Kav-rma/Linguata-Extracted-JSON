  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ wèn yíge nóngmín: zhè liǎngnián, nǐmende shōurù zěnmeyang? Tā shuō: zhè liǎngnián nóngyè shēngchǎn qíngkuàng bú cuò, shōurù yě hái hǎo."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō de huà yǒu yìxiē wǒ méi tīngmíngbai, suǒyǐ wǒ qǐng tā zài shuō yícì."
    },
    {
      "sequence_id": 3,
      "text": "Tā yòu gěi wǒ jiǎngle yícì, zhèicì wǒ jiù bǐjiào míngbai le."
    },
    {
      "sequence_id": 4,
      "text": "Tā shuō: xiànzài xiāngxiàde shēngchǎn hé shēnghuó qíngkuàng dōu hǎo yìdiǎn le, hěn duō rénde shōurù dōu duō le."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ juéde zhèige tímù hěn yǒu yìsi, suǒyǐ wǒ xiǎng duō gēn tā tántan, hǎo duō liǎojiě yìxiē xiāngxiàde qíngkuàng."
    }
  ],
