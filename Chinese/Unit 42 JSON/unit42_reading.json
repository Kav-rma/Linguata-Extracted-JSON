  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ wèn péngyou: nǐ jiějie xiànzài zěnme duì zhèngzhì wèntí rèxīn qǐlai le?"
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: zhè méiyou shénme qíguài, tā jīnnián kāishǐ niàn zhèngzhìxué le."
    },
    {
      "sequence_id": 3,
      "text": "Tā yòu shuō: wǒ jiějie bùdàn duì zhèngzhì hěn rèxīn, duì rén yě hěn rèxīn, shénme shíhou dōu xǐhuan bāng rén máng."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ shuō: zhèyàngde rén zhēn bù duō. Hěn duō rén shuōqǐlai róngyi, zuòqǐlai nán, kěshi nǐ jiějie bù yíyàng."
    },
    {
      "sequence_id": 5,
      "text": "Tā shuō: shì a, yīnwei tā duì zhèngzhìxué yǒu yánjiū, suǒyǐ tā cháng gēn wǒmen jiǎng dàlùde qíngkuàng, wǒmen dōu juéde hěn yǒu yìsi."
    }
  ],
