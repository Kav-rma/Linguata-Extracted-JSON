  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ zuò huǒchē dào Xīnjiāng qù. Chēshang yíge dāngdìde péngyou gěi wǒ jièshào: Xīnjiāng dì hěn dà, tǔdì hěn duō, zhùzhe hěn duō bùtóngde mínzú."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: zhèli zhǔyào shi Wéiwú'ěrzú zhùde dìfang, dàn yě yǒu Hànzú hé qítā mínzú, dàjiā zhù zài yìqǐ, hùxiāng bāngzhù, hěn tuánjié."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ wèn: jiěfàng yǐqián zhèli zěnmeyàng? Tā shuō: jiěfàng yǐqián zhèli hěn luàn, shēnghuó hěn xīnkǔ; jiěfàng yǐhòu, zhèngfǔ pài rén lái jiànshè, qíngkuàng jiù mànmàn hǎoqǐlai le."
    },
    {
      "sequence_id": 4,
      "text": "Tā yòu shuō: zhèi jǐnián, Xīnjiāngde jīngjì fāzhǎnde xiāngdāng kuài, hěn duō dìfang dōu yuè lái yuè fánróng le."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ xiǎng, yíge dìfang zhīsuǒyǐ néng fāzhǎn, bú dàn yào yǒu fēngfùde zīyuán, gèng yào yǒu bùtóng mínzú zhījiānde tuánjié hé hùxiāng bāngzhù."
    }
  ],
