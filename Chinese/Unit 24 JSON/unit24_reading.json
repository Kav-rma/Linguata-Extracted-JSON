  "articles": [
    {
      "sequence_id": 1,
      "text": "Zhèrde rén hěn duō. Wǒ xiǎng zuò chē qù kàn diànyǐng, kěshi bù zhīdao chē shénme shíhou lái."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ wèn: měi gé duōshǎo shíhou yǒu yìbān chē? Yǒu rén shuō: měi gé èrshífēn zhōng yǒu yìbān."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ měige Xīngqīliù dōu qù kàn diànyǐng, suǒyǐ zhèitiáo lù wǒ hěn shúxī."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ wèn: zuìhòu yìbān chē shi jǐdiǎn zhōng? Tā shuō: shíyīdiǎn shífēn."
    },
    {
      "sequence_id": 5,
      "text": "Yíbàn chē lái le. Wǒ wèn: zhèibān chē shì bu shi qù Xīméndīng? Sījī shuō: shì, shàng chē ba!"
    }
  ],
