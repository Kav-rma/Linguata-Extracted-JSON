  "articles": [
    {
      "sequence_id": 1,
      "text": "Huáng Kēzhǎng hé Huáng Tàitai dào le. Wǒ shuō: huānyíng, huānyíng, qǐng jìn."
    },
    {
      "sequence_id": 2,
      "text": "Huáng Tàitai gěi wǒ àiren yìdiǎn dōngxi, shuō: zhè shi yìdiǎn xiǎo yìsi. Wǒ zhīdao nín xǐhuan shānshuǐ huà, tèbié qǐng péngyou gěi nín huàle yìzhāng."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ shuō: nín zhēn shi tài kèqi le, xièxie. Ránhòu wǒ gěi tāmen jièshào: zhèiwèi shi Hé Jiàoshòu, zài Táidà jiāo jīngjìxué."
    },
    {
      "sequence_id": 4,
      "text": "Hé Jiàoshòu gēn Huáng Kēzhǎng shuō: jiǔyǎng, jiǔyǎng. Huáng Kēzhǎng wèn: nín láile duō jiǔ le? Hé Jiàoshòu shuō: wǒ gāng lái liǎngge yuè."
    },
    {
      "sequence_id": 5,
      "text": "Hé Jiàoshòu yòu shuō: zhèli hái yǒu hěn duō bù shúxide dìfang, yǐhòu hái yào xiàng nín qǐngjiào."
    }
  ],
