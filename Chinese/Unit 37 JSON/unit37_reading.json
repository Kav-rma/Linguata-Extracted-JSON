  "articles": [
    {
      "sequence_id": 1,
      "text": "Jīntian zhōngwǔ, wǒ xiǎng qǐng yíge péngyou yìqǐ qù chī zhōngfàn. Wǒ shuō: dào Dōngmén Cāntīng qù chī ba."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ péngyou shuō: Dōngménde cài kǒngpà méiyou Dàhuáde cài nàme hǎo ba. Wǒ shuō: suīrán Dōngmén bú tài hǎo, kěshi lí wǒmen zhèli jìn."
    },
    {
      "sequence_id": 3,
      "text": "Tā shuō: ō, hái yǒu yíge xīn kāide fànguǎnzi, lí wǒmen zhèli gèng jìn, tāmen nàlide cài fēicháng hǎo, jīntian wǒ qǐng nǐ dào nàli qù chī."
    },
    {
      "sequence_id": 4,
      "text": "Zhèige xīn fànguǎnzi zài Běijīng xiāngdāng yǒu míng, tīngshuō hěn duō rén dōu xǐhuan dào nàli qù."
    },
    {
      "sequence_id": 5,
      "text": "Chīwán fàn yǐhòu, wǒ péngyou shuō: xiàge Xīngqītiān wǒmen dào Shísānlíng qù yěcān, hǎo bu hǎo? Wǒ shuō: tài hǎo le."
    }
  ],
