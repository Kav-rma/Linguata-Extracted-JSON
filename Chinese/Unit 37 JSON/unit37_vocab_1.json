      "type": "short_answer",
      "answers": [
        {
          "answer_text": "The food there is extremely good.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 7,
      "question_text": "Jīntian wǒ qǐng ni dào nàli qù chī.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Today I am going to invite you to go there to eat.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 8,
      "question_text": "Nà bù hǎo yìsi!",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I can't let you do that! (That would be too embarrassing!)",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 9,
      "question_text": "Bié kèqi, méi shenme. Nèige dìfangde cài yòu hǎo yòu piányi.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Don't be polite. It's nothing. The food there is both good and cheap.",
          "is_correct": true
