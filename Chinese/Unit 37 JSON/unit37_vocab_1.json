  "questions_and_answers": [
    {
      "sequence_id": 1,
      "question_text": "Jīntian wǒmen yìqǐ qù chī zhōngfàn, hǎo ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Let's go have lunch together today. Okay?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 2,
      "question_text": "Hǎo a, dào Dōngmén Cāntīng qu chī ba.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "All right. Why don't we go to the East Gate Restaurant?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 3,
      "question_text": "Dōngménde cài kǒngpà méiyou Dàhuáde cài nàme hǎo ba.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I'm afraid that the food at the East Gate isn't as good as the food at the Great China.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 4,
      "question_text": "Suīrán bú tài hǎo, kěshi lí wǒmen zhèli jìn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Even though it is not too good, it is close to us.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 5,
      "question_text": "Ou, hái yǒu yíge xīn kāide fànguǎnzi lí wǒmen zhèli gèng jìn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Oh, there is also a newly opened restaurant that is even closer to us.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 6,
      "question_text": "Tāmen nàlide cài fēicháng hǎo.",
