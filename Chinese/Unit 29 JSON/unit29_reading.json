  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào chēzhàn zuò huǒchē. Wǒ wèn: jǐdiǎn zhōng fā chē? Gōngzuò rényuán shuō: shíbādiǎn wǔshíwǔfēn fā chē."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: qǐng nǐ bǎ nǐde hùzhào hé lǚxíngzhèng gěi wǒ. Wǒ shuō: hǎo, gěi nǐ."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ wèn: dào Shànghǎi qùde chē zài dìjǐ zhàntái? Tā shuō: zài dìyī zhàntái."
    },
    {
      "sequence_id": 4,
      "text": "Tā kànjian wǒ yǒu diǎnr jǐnzhāng, jiù shuō: bié yòng jí, hái zǎo ne, nǐ xiān zài jiēdàishì xiūxi xiūxi."
    },
    {
      "sequence_id": 5,
      "text": "Jiēdàishì lǐ hěn shūfu. Yǒu yíge rén hái bāng wǒ ná xíngli, wǒ juéde zhèli fúwù hěn hǎo."
    }
  ],
