  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ xiǎng mǎi yíge huāpíng. Qǐng gěi wǒ kànkan nèige, hǎo ma?"
    },
    {
      "sequence_id": 2,
      "text": "Nǐ yào nǎige? Zhèige lánde háishi zhèige hóngde? Nèi liǎngge dōu gěi wǒ kànkan."
    },
    {
      "sequence_id": 3,
      "text": "Lánde tài guì le. Wǒ mǎi hóngde ba, hóngde piányi."
    },
    {
      "sequence_id": 4,
      "text": "Zhèige yě piányi, zhèige bù guì."
    },
    {
      "sequence_id": 5,
      "text": "Zhèi liǎngge xuéshēng, nǎige hǎo? Wǒ xiǎng Sīmǎ Xīn hǎo."
    }
