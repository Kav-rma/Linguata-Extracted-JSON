{
  "title": "unit18_vocab_1",
  "type": "vocabulary",
  "questions_and_answers": [
    {
      "sequence_id": 1,
      "question_text": "Qǐngwèn, nǐmen zhèli kěyi huàn Měijīn ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "May I ask, can U.S. currency be changed here?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 2,
      "question_text": "Duìbuqǐ, bù kěyi.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I'm sorry, that's not possible.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 3,
      "question_text": "Lǚxíng zhīpiào ne?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "How about traveler's checks?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 4,
      "question_text": "Yě bù kěyi. Nín děi zài Táiwān Yínháng huàn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "That's not possible either. You have to change them at the Bank of Taiwan.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 5,
      "question_text": "Yínháng shénme shíhou kāi mén?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "When does the bank open?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 6,
      "question_text": "Jiǔdiǎn zhōng kāi mén.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It opens at nine o'clock.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 7,
      "question_text": "Jǐdiǎn zhōng guān mén?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "What time does it close?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 8,
      "question_text": "Sāndiǎn zhōng guān mén.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It closes at three o'clock.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 9,
      "question_text": "Xiànzài jǐdiǎn zhōng? Hái kěyi huàn ba?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "What time is it now? I may still change money, I suppose?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 10,
      "question_text": "Xiànzài liǎngdiǎn bàn. Hái kěyi huàn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It's half past two now. You may still change money.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 11,
      "question_text": "Wǒ yào huàn yìdiǎn Táibì. Zhè shi yìbǎikuài Měijīnde lǚxíng zhīpiào.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I want to change some money into Taiwan currency. Here are one hundred U.S. dollars in traveler's checks.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Hǎo. Yíkuài Měijīn huàn sānshibākuài Táibì.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Certainly. One U.S. dollar is thirty-eight dollars in Taiwan currency.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 13,
      "question_text": "Zhè shi wǔzhāng èrshikuàide lǚxíng zhīpiào.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Here are five 20-dollar traveler's checks.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 14,
      "question_text": "Qǐng nín děngyiděng. Wǒ jiù lái.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Please wait a moment. I'll be right back.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 15,
      "question_text": "Wǒ yào diǎn xiǎo piàozi. Zhèzhāng yìbǎikuàide qǐng ni gěi wo huànhuan, xíng bu xíng?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I would like some small bills. Please change this 100-dollar bill for me. Would that be all right?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 16,
      "question_text": "Xíng. Gěi nín jiǔzhāng shíkuàide, liǎngzhāng wǔkuàide.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "All right. I'll give you nine tens and two fives.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 17,
      "question_text": "Máfan ni le.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Sorry to have bothered you.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 18,
      "question_text": "Méi shenme.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It's nothing.",
          "is_correct": true
        }
      ]
    },
