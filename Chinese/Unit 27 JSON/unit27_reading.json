  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ yào qù Táinán. Wǒ wèn péngyou: nǐ shuō shi zuò huǒchē qù hǎo ne, háishi zuò gōnglùjū qù hǎo ne?"
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: dào Táinán zuò huǒchē zuì fāngbian."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ wèn: děi xiān mǎi piào ma? Tā shuō: nǐ zuìhǎo liǎngsāntian yǐqián qù mǎi piào."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ wèn: zuò gōnglùjū yě děi xiān mǎi piào ma? Tā shuō: zuò gōnglùjū bú bì xiān mǎi piào."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ xiǎng zuò shàngwǔde chē, kěshi dào le chēzhàn, shàngwǔde piào dōu màiwán le, suǒyǐ wǒ zhǐ hǎo mǎi xiàwǔde."
    }
  ],
