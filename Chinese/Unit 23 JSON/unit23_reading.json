  "articles": [
    {
      "sequence_id": 1,
      "text": "Yíge rén zài lùshang zǒu, yíge gōngzuò rényuán wèn tā: nǐ yǒu shénme shì a?"
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: qǐngwèn, zhèitiáo lù shi shénme lù? Nà rén shuō: zhè shi Nánjīng Xīlù."
    },
    {
      "sequence_id": 3,
      "text": "Tā shuō: wǒ zhǎo Nánjīng Dōnglù Yíduàn Wǔshísìxiàng, kěshi wǒ zhǎobudào."
    },
    {
      "sequence_id": 4,
      "text": "Nà rén gàosu tā: Nánjīng Dōnglù lí zhèr bù yuǎn, nǐ wǎng dōng zǒu, guòle liǎngge lùkǒu jiù dào le."
    },
    {
      "sequence_id": 5,
      "text": "Yīnwei zhèitiáo lù hěn cháng, yòu fēnchéng jǐduàn, suǒyǐ zhǎo dìfang de shíhou yídìng yào kàn qīngchu shi dìjǐduàn."
    }
  ],
