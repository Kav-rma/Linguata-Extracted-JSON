  "questions_and_answers": [
    {
      "sequence_id": 1,
      "question_text": "Wèi, Měidàsī.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Hello. Department of American and Oceanic Affairs.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 2,
      "question_text": "Wǒ shi Jiānádà Dàshǐguǎnde Qiáozhì Dáfēi. Wǒ yǒu yíjiàn shì xiǎng gēn Wáng Kēzhǎng jiǎngyijiǎng.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I am George Duffy of the Canadian Embassy. I have something I would like to discuss with Section Chief Wáng.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 3,
      "question_text": "Ou, tā xiànzài zài kāi huì.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Oh, she is at a meeting now.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 4,
      "question_text": "Děng tā kāiwán huì wǒ gàosong ta gěi ni huí diànhuà.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "When she is finished with the meeting, I will tell her to return your call.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 5,
      "question_text": "Hǎo, xièxie ni.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Fine. Thank you.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 6,
      "question_text": "Bú xiè.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Don't mention it.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 7,
      "question_text": "Duìbuqǐ, jīntian zǎoshang nǐ dǎ diànhuà láide shíhou wǒ zài kāi huì, méi shíjiān gēn ni shuō huà.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I'm sorry. When you called here this morning, I was in a meeting and didn't have time to speak with you.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 8,
      "question_text": "Méi guānxi. Wǒ zhīdao nǐ hěn máng.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It doesn't matter. I know you are very busy.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 9,
      "question_text": "Wǒ gěi ni dǎ diànhuàde mùdì shi xiǎng gēn ni dāngmiàn tántan.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "The reason I called you is that I would like to talk with you in person.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 10,
      "question_text": "Hǎo a. Shénme shíhou a?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "All right. When?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 11,
      "question_text": "Míngtian duì ni héshì ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Would tomorrow be all right for you?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Míngtian xiàwǔ shénme shíhou dōu kěyi.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Any time tomorrow afternoon would be fine.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 13,
      "question_text": "Zài nǎr jiàn ne?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Where shall we meet?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 14,
      "question_text": "Liǎngdiǎn zhōng qǐng ni dào wǒ zhèr lái, xíng bu xíng?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Please come over here at two o'clock. All right?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 15,
      "question_text": "Hǎo. Míngtian liǎngdiǎn zhōng jiàn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Okay. See you tomorrow at two o'clock.",
          "is_correct": true
        }
      ]
    },
    {
