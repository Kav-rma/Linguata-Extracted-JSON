  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ shi Jiānádà Dàshǐguǎnde rén. Wǒ dǎ diànhuà dào Wàijiāobù, xiǎng gēn Wáng Kēzhǎng jiǎngjiang huà."
    },
    {
      "sequence_id": 2,
      "text": "Jiē diànhuàde rén shuō: ō, tā xiànzài zài kāi huì."
    },
    {
      "sequence_id": 3,
      "text": "Tā yòu shuō: děng tā kāiwán huì, wǒ gàosong tā gěi nǐ huí diànhuà."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ shuō: hǎo, xièxie nǐ. Wǒ bǎ wǒde diànhuà hàomǎr gàosong le tā."
    },
    {
      "sequence_id": 5,
      "text": "Yīnwei zhèijiàn shì bǐjiào jǐn, suǒyǐ wǒ xīwang Wáng Kēzhǎng kāiwán huì yǐhòu néng mǎshàng gěi wǒ huí diànhuà."
    }
  ],
