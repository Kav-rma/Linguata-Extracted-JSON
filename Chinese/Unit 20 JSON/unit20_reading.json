  "articles": [
    {
      "sequence_id": 1,
      "text": "Qǐngwèn, Dōngdān Diànyǐngyuàn shì bu shi zài zhèr fùjìn? Shì, jiù zài zhèr fùjìn."
    },
    {
      "sequence_id": 2,
      "text": "Nǐ zhīdao diànyǐngyuàn fùjìn yǒu méiyou yínháng? Yǒu, diànyǐngyuàn fùjìn yǒu yíge yínháng."
    },
    {
      "sequence_id": 3,
      "text": "Nǐ zhīdao bu zhīdao yínháng shénme shíhou guān mén? Wǒ xiǎng xiàwǔ wǔdiǎn zhōng guān mén."
    },
    {
      "sequence_id": 4,
      "text": "Dào yínháng zěnme zǒu? Guòle lùkǒu wǎng zuǒ zǒu jiù dào le, bù yuǎn."
    },
    {
      "sequence_id": 5,
      "text": "Jīntian tiānqi hěn rè. Wǒ xiǎng, zuìhǎo xiān qù yínháng, ránhòu zài qù kàn diànyǐng."
    }
