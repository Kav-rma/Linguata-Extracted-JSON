  "articles": [
    {
      "sequence_id": 1,
      "text": "Yǒu rén gēn wǒ jiǎng Zhōngguóde zīyuán. Tā shuō: Zhōngguóde méitàn zīyuán bù shǎo, chǎnliàng yě hěn gāo, xiànzài zài shìjièshang zhàn dìsānwèi."
    },
    {
      "sequence_id": 2,
      "text": "Tā yòu shuō: cóngqián Zhōngguóde shíyóu dàbùfen zài lí biānjìng bù yuǎnde dìfang, xiànzài yánhǎi yídàide shíyóu yě fāzhǎnqǐlai le."
    },
    {
      "sequence_id": 3,
      "text": "Tā shuō: zhèi jǐnián, yánhǎi yídàide chéngshì jiànshède hěn kuài, yǐjīng chéngle guójiā jīngjìde yíge zhòngxīn."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ wèn: nà xīběi yídài ne? Tā shuō: xīběi zīyuán yě hěn duō, zhǐshi jiāotōng bù fāngbian, suǒyǐ fāzhǎnde màn yìdiǎn."
    },
    {
      "sequence_id": 5,
      "text": "Zǒngde lái shuō, Zhōngguóde zīyuán xiāngdāng fēngfù, zhǐ yào hǎohāor zǔzhī, jiānglái yídìng huì yǒu gèng dàde fāzhǎn."
    }
  ],
