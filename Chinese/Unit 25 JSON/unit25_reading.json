  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ zuò chē qù péngyou jiā. Wǒ bǎ shū fàng zài zhuōzishang, jiù shàng chē le."
    },
    {
      "sequence_id": 2,
      "text": "Chēshang rén hěn duō. Wǒ wèn péngyou: zánmen shì bu shi zuòguò zhàn le?"
    },
    {
      "sequence_id": 3,
      "text": "Tā shuō: hái méi ne, xià yízhàn cái xià chē."
    },
    {
      "sequence_id": 4,
      "text": "Yīnwei wǒmen shuō huà, méi zhùyì, suǒyǐ zhēnde zuòguò le yízhàn. Wǒmen zhǐ hǎo wǎng huí zǒu."
    },
    {
      "sequence_id": 5,
      "text": "Dào péngyou jiāde shíhou yǐjīng bú zǎo le. Wǒ péngyou shuō: hǎo, xiànzài zánmen chī fàn ba!"
    }
