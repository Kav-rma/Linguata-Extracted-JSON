  "articles": [
    {
      "sequence_id": 1,
      "text": "Jīntian zǎoshang wǒ xiǎng chūqu mǎi jǐběn shū. Wǒ hái xiǎng mǎi yìběn Hàn-Yīng zìdiǎn."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ bù zhīdao nǎr yǒu mǎi shūde, suǒyǐ wǒ wèn yíge rén: lǎojia, nǎr yǒu mǎi shūde?"
    },
    {
      "sequence_id": 3,
      "text": "Tā shuō: Wángfǔjǐng Dàjiē yǒu yíge Xīnhuá Shūdiàn, hěn dà."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ wèn: Xīnhuá Shūdiàn lí zhèr yuǎn ma? Tā shuō: bù yuǎn, hěn jìn, nǐ zǒu dào nàli jiù kànjian le."
    },
    {
      "sequence_id": 5,
      "text": "Yīnwei bù yuǎn, suǒyǐ wǒ méiyou zuò chē, wǒ zǒuzhe qù. Zǒule shífēn zhōng jiù dào le."
    }
  ],
