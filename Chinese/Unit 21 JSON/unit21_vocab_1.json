  "questions_and_answers": [
    {
      "sequence_id": 1,
      "question_text": "Nǐ chūqu a!",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Oh, you're going out!",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 2,
      "question_text": "Wǒ xiǎng chūqu mǎi jǐběn shū.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I thought I would go out to buy a few books.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 3,
      "question_text": "Láojià, nǎr yǒu mài shūde?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Excuse me, where is there a place to buy books?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 4,
      "question_text": "Wángfǔjǐng Dàjiē yǒu yíge Xīnhuá Shūdiàn, hěn dà.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "There is a New China Bookstore on Wángfǔjǐng Boulevard that is very large.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 5,
      "question_text": "Xīnhuá Shūdiàn lí zhèr yuǎn ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Is the New China Bookstore far from here?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 6,
      "question_text": "Bù yuǎn, hěn jìn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It's not far; it's very close.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 7,
      "question_text": "Zěnme qù? Zǒuzhe qù kěyi ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "How do I go? Is it possible to get there by walking?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 8,
      "question_text": "Zǒuzhe qù kěyi.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It's possible to get there by walking.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 9,
      "question_text": "Zěnme zǒu?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "How do I go?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 10,
      "question_text": "Cóng dàmén chūqu, cháo běi guǎi, jiù shi Wángfǔjǐng Dàjiē.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "You go out the entrance, turn to the north, and that's Wángfǔjǐng Boulevard.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 11,
      "question_text": "Wǒ cóng dàmén chūqu, cháo běi guǎi, duì bu duì?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I go out the entrance and turn to the north. Is that correct?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Duì le.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "That's correct.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 13,
      "question_text": "Zǒu duō yuǎn?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "How far do I go?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 14,
      "question_text": "Zǒu bù yuǎn, lùdōngde dìyīge dàlóu jiù shi Xīnhuá Shūdiàn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Go a short distance, and the first building on the east side of the street is the New China Bookstore.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 15,
