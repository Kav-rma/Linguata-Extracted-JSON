  "articles": [
    {
      "sequence_id": 1,
      "text": "ĀNDÉSĒN XIĀNSHENG: Ài, jìchéngchē!"
    },
    {
      "sequence_id": 2,
      "text": "MR. ANDERSON: Hey, taxi!"
    },
    {
      "sequence_id": 3,
      "text": "SĪJĪ: Nǐ dào nǎli?"
    },
    {
      "sequence_id": 4,
      "text": "DRIVER: Where are you going?"
    },
    {
      "sequence_id": 5,
      "text": "ĀNDÉSĒN XIĀNSHENG: Dào huǒchēzhàn."
    },
    {
      "sequence_id": 6,
      "text": "MR. ANDERSON: To the train station."
    },
    {
      "sequence_id": 7,
      "text": "SĪJĪ: Zhǐ yǒu zhè yíjiàn xíngli ma? Wǒ bǎ xíngli fàng zai qiánbian."
    },
    {
      "sequence_id": 8,
      "text": "DRIVER: Is there only this one piece of luggage? I'll put the suitcase in front."
    },
    {
      "sequence_id": 9,
      "text": "ĀNDÉSĒN XIĀNSHENG: Nǐ kāide tài kuài le! Qǐng màn yìdiǎn kāi."
    },
    {
      "sequence_id": 10,
      "text": "MR. ANDERSON: You're driving too fast! Please drive a little slower."
    },
    {
      "sequence_id": 11,
      "text": "SĪJĪ: Hǎo. Wǒmen yǒu shíjiān, láidejí."
    },
    {
      "sequence_id": 12,
      "text": "DRIVER: Okay. We have time; we can make it."
    },
    {
      "sequence_id": 13,
      "text": "ĀNDÉSĒN XIĀNSHENG: Duōshao qián?"
    },
    {
      "sequence_id": 14,
      "text": "MR. ANDERSON: How much is it?"
    },
    {
      "sequence_id": 15,
      "text": "SĪJĪ: Èrshiqīkuài."
    },
    {
      "sequence_id": 16,
      "text": "DRIVER: Twenty-seven dollars."
    }
  ],
