      "type": "short_answer",
      "answers": [
        {
          "answer_text": "He doesn't drive fast.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 9,
      "question_text": "Wǒmen yǒu shíjiān, láidejí.",
