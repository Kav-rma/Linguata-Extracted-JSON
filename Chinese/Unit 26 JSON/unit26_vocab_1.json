      "answers": [
        {
          "answer_text": "Please drive a little slower.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 11,
      "question_text": "Bié kāi nàme kuài!",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Don't drive so fast!",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Zhè shi nínde xíngli.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Here is your suitcase.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 13,
      "question_text": "Xièxie. Duōshao qián?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Thank you. How much is it (the fare)?",
