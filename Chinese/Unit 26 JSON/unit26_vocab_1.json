      "answers": [
        {
          "answer_text": "Twenty-seven dollars.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 15,
      "question_text": "Zhè shi sānshikuài, bú yòng zhǎo le.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Here's thirty dollars. Keep the change. (literally, \"No need to give me change.\")",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 16,
      "question_text": "Qǐng ni zài qiánbian nèige yínháng tíng yíxià.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Please stop at that bank up ahead for a moment.",
