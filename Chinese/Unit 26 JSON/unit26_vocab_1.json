      "type": "short_answer",
      "answers": [
        {
          "answer_text": "We have time. We can make it in time.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 10,
      "question_text": "Qǐng màn yìdiǎn kāi.",
