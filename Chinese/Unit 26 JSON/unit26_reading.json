  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ zài lùbiān jiào le yíliàng jìchéngchē. Sījī wèn: nǐ dào nǎli? Wǒ shuō: dào huǒchēzhàn."
    },
    {
      "sequence_id": 2,
      "text": "Sījī wèn: zhǐ yǒu zhè yíjiàn xíngli ma? Wǒ shuō: shì. Tā jiù bǎ xíngli fàng zài qiánbian."
    },
    {
      "sequence_id": 3,
      "text": "Zhèige sījī kāi chē kāide tài kuài le, wǒ yǒu diǎnr jǐnzhāng."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ shuō: qǐng nǐ kāi màn yìdiǎn. Tā jiù kāide màn le."
    },
    {
      "sequence_id": 5,
      "text": "Yīnwei chē kāide bú màn, suǒyǐ wǒmen hěn kuài jiù dào le huǒchēzhàn. Wǒ bǎ qián gěi tā, jiù xià chē le."
    }
