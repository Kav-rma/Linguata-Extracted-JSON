  "articles": [
    {
      "sequence_id": 1,
      "text": "Jīntian wǒ cóng túshūguǎn jièle yìběn hǎo xiǎoshuō. Wǒ péngyou wèn: shénme xiǎoshuō, ràng nǐ zhème gāoxìng?"
    },
    {
      "sequence_id": 2,
      "text": "Wǒ shuō: zhèiběn xiǎoshuō xiěde shi dàlùde qíngkuàng, xiěde xiāngdāng hǎo."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ péngyou shuō: guānyú dàlùde? Jiè gěi wǒ kànkan xíng bu xíng?"
    },
    {
      "sequence_id": 4,
      "text": "Wǒ shuō: xíng, búguò wǒ hái méi kànwán ne, děng wǒ kànwán le zài jiè gěi nǐ."
    },
    {
      "sequence_id": 5,
      "text": "Zhèiběn xiǎoshuō ràng wǒ duì dàlùde qíngkuàng yǒule gèng duōde liǎojiě, suǒyǐ wǒ juéde fēicháng yǒu yìsi."
    }
  ],
