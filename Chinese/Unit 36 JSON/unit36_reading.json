  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dǎ diànhuà dào Wàijiāobù. Wǒ shuō: wéi, shi Wàijiāobù ma? Wǒ yào zhǎo Lín Sīzhǎng shuō huà."
    },
    {
      "sequence_id": 2,
      "text": "Jiē diànhuàde rén wèn: nín shi nǎr a? Wǒ shuō: wǒ xìng Lěikèlěiěr, wǒ shi Fǎguo Dàshǐguǎnde Shāngwù Jīngjìguān."
    },
    {
      "sequence_id": 3,
      "text": "Tā shuō: nín děngyiděng, wǒ gěi nín kànkan tā zài bu zài. Guòle yìhuǐr tā shuō: tā zhèihuǐr bú zài, nín yào liú ge huàr ma?"
    },
    {
      "sequence_id": 4,
      "text": "Wǒ shuō: lǎojia, tā huílaide shíhou, nín qǐng tā gěi wǒ dǎ ge diànhuà."
    },
    {
      "sequence_id": 5,
      "text": "Tā shuō: hǎo, qǐng nín bǎ nínde diànhuà hàomǎr gàosong wǒ, wǒ xiěxialai. Wǒ shuō: wǒde diànhuà shi wǔ èr yāo sān sān yāo."
    }
  ],
