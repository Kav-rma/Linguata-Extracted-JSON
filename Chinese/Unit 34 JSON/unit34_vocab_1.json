{
  "title": "unit34_vocab_1",
  "type": "vocabulary",
  "questions_and_answers": [
    {
      "sequence_id": 1,
      "question_text": "Huáng Kēzhǎng, nín xiàge Xīngqīliù yǒu gōngfu ma?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Section Chief Huáng, are you free Saturday of next week?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 2,
      "question_text": "Wǒ xiǎng qǐng nín hé nín fūren dào wǒmen jiā lái chī ge biànfàn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I would like to invite you and your wife to come to our house for a simple meal.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 3,
      "question_text": "Nín hébì zhème kèqi?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Why is it necessary to be so polite?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 4,
      "question_text": "Bú shi kèqi.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "It's not politeness.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 5,
      "question_text": "Wǒ yǒu yíge péngyou gāng cóng Měiguo lái.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I have a friend who has just come from America.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 6,
      "question_text": "Tā xiànzài zài Táiwān Dàxué jiāo jīngjìxué.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "She is teaching economics at Taiwan University right now.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 7,
      "question_text": "Wǒ hěn xiǎng gěi nǐmen liǎngwèi jièshao jièshao.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I would very much like to introduce the two of you.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 8,
      "question_text": "Nà tài hǎo le!",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "That's wonderful!",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 9,
      "question_text": "Hěn xīwàng gēn ta tántan.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I wish very much to talk with her.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 10,
      "question_text": "Búguò, kǒngpà wǒde Yīngwén bù xíng.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "However, I'm afraid that my English isn't good enough.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 11,
      "question_text": "Búdàn shuōde bù hǎo, yǒu shíhou yě tīngbudǒng.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Not only don't I speak well, but sometimes I can't understand what I hear either.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 12,
      "question_text": "Nǎli, nǎli.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Not at all, not at all.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 13,
      "question_text": "Nín shuōde gēn Měiguo rén yíyàng hǎo.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "You speak as well as an American.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 14,
      "question_text": "Zěnmeyàng? Liùdiǎn bàn duì nín fāngbian bu fāngbian?",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "How shall we do it? Would six-thirty be convenient for you?",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 15,
      "question_text": "Fāngbian, fāngbian.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "That would be fine.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 16,
      "question_text": "Wǒ méi qǐng shénme rén. Hěn suíbiàn.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "I haven't invited anyone special. It's very informal.",
          "is_correct": true
        }
      ]
    },
    {
      "sequence_id": 17,
      "question_text": "Nà jiù xiān xiè le.",
      "has_answer": true,
      "type": "short_answer",
      "answers": [
        {
          "answer_text": "Well then, I'll thank you in advance.",
          "is_correct": true
        }
      ]
    },
