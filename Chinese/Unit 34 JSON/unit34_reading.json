  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ qǐng Huáng Kēzhǎng shuō: nín xiàge Xīngqīliù yǒu gōngfu ma? Wǒ xiǎng qǐng nín hé nín fūren dào wǒmen jiā lái chī ge biànfàn."
    },
    {
      "sequence_id": 2,
      "text": "Huáng Kēzhǎng shuō: nín hébì zhème kèqi? Wǒ shuō: bú shi kèqi."
    },
    {
      "sequence_id": 3,
      "text": "Wǒ yǒu yíge péngyou gāng cóng Měiguo lái, tā xiànzài zài Táiwān Dàxué jiāo jīngjìxué, wǒ hěn xiǎng gěi nǐmen liǎngwèi jièshào jièshào."
    },
    {
      "sequence_id": 4,
      "text": "Huáng Kēzhǎng shuō: nà tài hǎo le, wǒ hěn xīwang gēn tā tántan. Búguò, kǒngpà wǒde Yīngwén bù xíng."
    },
    {
      "sequence_id": 5,
      "text": "Tā shuō: wǒ bùdàn shuōde bù hǎo, yǒu shíhou yě tīngbudǒng. Wǒ shuō: méi guānxi, tā huì shuō Zhōngwén."
    }
  ],
