  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ dào Chángchéng qù cānguān. Dǎoyóu gěi wǒmen jièshào shuō: Chángchéng shi shìjièshang zuì yǒu míngde jiànzhù zhīyī, měinián dōu yǒu hěn duō wàiguó yóukè lái cānguān."
    },
    {
      "sequence_id": 2,
      "text": "Tā shuō: Chángchéng bú shi yíge cháodài xiūjiànde, cóng hěn zǎo yǐqián jiù kāishǐ xiū, hòulái jǐge cháodài dōu xiūguo, suǒyǐ tā fēicháng cháng, yě fēicháng xióngwěi."
    },
    {
      "sequence_id": 3,
      "text": "Yǒu yíge yóukè wèn: xiūjiàn Chángchéng yòngle duōshǎo rén? Dǎoyóu shuō: nà bù zhīdao yǒu duōshǎo, zǒngzhī shi hěn duō hěn duō rén, huāle bù shǎode gōngfu hé lìqi."
    },
    {
      "sequence_id": 4,
      "text": "Zhàn zài Chángchéngshang wǎng yuǎnchù kàn, shān yíge jiēzhe yíge, jǐngsè fēicháng měi, dàjiā dōu juéde bù xū zhèi yítàng."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ xiǎng, Chángchéng zhīsuǒyǐ ràng zhème duō rén pèifú, bú dàn yīnwei tā cháng, gèng yīnwei tā dàibiǎole gǔdài rénmínde zhìhuì hé lìliang."
    }
  ],
