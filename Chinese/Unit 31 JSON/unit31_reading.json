  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ zài lùshang pèngjian yíge lǎo péngyou. Tā shuō: hǎo jiǔ méi jiàn, nín chū mén le ba?"
    },
    {
      "sequence_id": 2,
      "text": "Wǒ shuō: shì a, wǒ yòu dào Guǎngzhōu qù le."
    },
    {
      "sequence_id": 3,
      "text": "Tā wèn: nín wèishénme gāng huílai, yòu qù le ne? Wǒ shuō: wǒ zhèicì dào Guǎngzhōu qù shi yīnwei wǒ yǒu yíge hěn hǎode péngyou cóng Xiānggǎng lái."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ péngyou zhǐ zài Guǎngzhōu zhù jǐtian, suǒyǐ wǒ yídìng yào qù kàn tā."
    },
    {
      "sequence_id": 5,
      "text": "Wǒmen liǎngge rén hǎo jiǔ méi jiàn le, zhèicì jiànmiàn, dōu hěn gāoxìng."
    }
  ],
