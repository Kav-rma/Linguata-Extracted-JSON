  "articles": [
    {
      "sequence_id": 1,
      "text": "Wǒ zài Měiguo Guówùyuàn gōngzuò. Wǒ péngyou bú zài Guówùyuàn gōngzuò, tā shi xuéshēng."
    },
    {
      "sequence_id": 2,
      "text": "Wǒ lái Zhōngguo shi lái niàn shū de. Wǒ niàn lìshǐ, wǒ péngyou zài zhèli xué Zhōngwén."
    },
    {
      "sequence_id": 3,
      "text": "Nǐ huì shuō Zhōngguo huà ma? Wǒ huì shuō yìdiǎn. Qùnián wǒ bú huì, xiànzài huì le."
    },
    {
      "sequence_id": 4,
      "text": "Yǒu rén shuō wǒde Zhōngguo huà hěn hǎo. Wǒ shuō: nǎli, nǎli, wǒ zhǐ huì shuō yìdiǎn."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ shi zài Táiwān Dàxué xuéde Yīngwén. Wǒ àiren bú huì shuō Yīngwén."
    }
  ],
