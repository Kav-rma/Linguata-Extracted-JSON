  "articles": [
    {
      "sequence_id": 1,
      "text": "Zuótian wǒ mǎile yìdiǎn pénziwǎn. Wǒ mǎile shíge fànwǎn, shíge dà pánzi."
    },
    {
      "sequence_id": 2,
      "text": "Nǐ mǎi shénme le? Wǒ mǎi fànwǎn le. Nǐ mǎile duōshǎo? Wǒ mǎile shíge."
    },
    {
      "sequence_id": 3,
      "text": "Nàxiē pánziwǎn shi shénme yánsè de? Shi lánde. Ō, wǒ yě xǐhuan lánde."
    },
    {
      "sequence_id": 4,
      "text": "Nǐ shi zài shénme dìfang mǎide? Shi zài Dìyī Gōngsī mǎide."
    },
    {
      "sequence_id": 5,
      "text": "Zhèxiē zázhì, yǒude wǒ kànguo le, yǒude wǒ hái méi kàn."
    }
  ],
