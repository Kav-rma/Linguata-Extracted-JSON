  "articles": [
    {
      "sequence_id": 1,
      "text": "Jīntian xiàwǔ wǒ xiǎng dào kāfēitīng qù. Wǒ péngyou gàosu wǒ, zài fùjìn yǒu yíge Huáměi Kāfēitīng, hěn hǎo."
    },
    {
      "sequence_id": 2,
      "text": "Kěshi wǒ bú rènshi lù, yě bù zhīdao Huáměi Kāfēitīng zài nǎr, suǒyǐ wǒ wèn yíge rén: dào nàli qù, zěnme zǒu?"
    },
    {
      "sequence_id": 3,
      "text": "Tā shuō: cóng zhèli wǎng zuǒ zǒu, bù yuǎn jiù dào le."
    },
    {
      "sequence_id": 4,
      "text": "Wǒ céngqián méi qùguo zhèige kāfēitīng, zhè shi dìyīcì. Wǒ péngyou qùguo, tā shuō nàrde kāfēi hěn hǎo."
    },
    {
      "sequence_id": 5,
      "text": "Wǒ zǒule yìhuǐr jiù dào le. Zhèige kāfēitīng zhēn bú cuò, wǒ hěn xǐhuan."
    }
  ],
